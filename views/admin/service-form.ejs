
<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= title || "Add Service" %></title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
        rel="stylesheet"
    >

    <link rel="stylesheet" href="/css/style.css">

</head>


<body>

<div class="admin-page">

    <!-- SIDEBAR -->

    <aside class="admin-sidebar">

        <div class="admin-brand">

            <div class="admin-brand-icon">
                <i class="bi bi-building"></i>
            </div>

            <div>
                <h5>Bishnu Palika</h5>
                <small>Admin Panel</small>
            </div>

        </div>


        <div class="admin-menu-title">
            MAIN MENU
        </div>


        <nav class="admin-menu">

            <a href="/admin/dashboard" class="admin-menu-link">
                <i class="bi bi-grid-1x2-fill"></i>
                <span>Dashboard</span>
            </a>

            <a href="/admin/notices" class="admin-menu-link">
                <i class="bi bi-megaphone-fill"></i>
                <span>Notices</span>
            </a>

            <a href="/admin/news" class="admin-menu-link">
                <i class="bi bi-newspaper"></i>
                <span>News & Events</span>
            </a>

            <a href="/admin/services" class="admin-menu-link active">
                <i class="bi bi-person-workspace"></i>
                <span>Services</span>
            </a>

            <a href="/admin/wards" class="admin-menu-link">
                <i class="bi bi-geo-alt-fill"></i>
                <span>Wards</span>
            </a>

            <a href="/admin/downloads" class="admin-menu-link">
                <i class="bi bi-download"></i>
                <span>Downloads</span>
            </a>

            <a href="/admin/gallery" class="admin-menu-link">
                <i class="bi bi-images"></i>
                <span>Gallery</span>
            </a>

            <a href="/admin/slider" class="admin-menu-link">
                <i class="bi bi-sliders"></i>
                <span>Homepage Slider</span>
            </a>


            <div class="admin-menu-title">
                SETTINGS
            </div>


            <a href="/admin/profile" class="admin-menu-link">
                <i class="bi bi-person-circle"></i>
                <span>Profile</span>
            </a>

            <a href="/admin/settings" class="admin-menu-link">
                <i class="bi bi-gear-fill"></i>
                <span>Settings</span>
            </a>

            <a
                href="/"
                target="_blank"
                class="admin-menu-link"
            >
                <i class="bi bi-globe"></i>
                <span>View Website</span>
            </a>

        </nav>


        <div class="admin-sidebar-bottom">

            <a href="/admin/login">
                <i class="bi bi-box-arrow-left"></i>
                <span>Logout</span>
            </a>

        </div>

    </aside>


    <!-- MAIN -->

    <main class="admin-main">

        <!-- TOPBAR -->

        <header class="admin-topbar">

            <div class="d-flex align-items-center gap-3">

                <button
                    class="admin-mobile-menu"
                    onclick="toggleAdminSidebar()"
                >
                    <i class="bi bi-list"></i>
                </button>


                <div>

                    <h4>
                        <%= mode === "edit" ? "Edit Service" : "Add Service" %>
                    </h4>

                    <p>
                        <%= mode === "edit"
                            ? "Update citizen service information"
                            : "Create a new citizen service"
                        %>
                    </p>

                </div>

            </div>


            <div class="admin-user">

                <div class="admin-user-icon">
                    <i class="bi bi-person-fill"></i>
                </div>

                <div>

                    <strong>Administrator</strong>
                    <small>Super Admin</small>

                </div>

            </div>

        </header>


        <!-- CONTENT -->

        <div class="admin-content">


            <!-- BREADCRUMB -->

            <div class="admin-breadcrumb mb-4">

                <a href="/admin/dashboard">
                    Dashboard
                </a>

                <i class="bi bi-chevron-right"></i>

                <a href="/admin/services">
                    Services
                </a>

                <i class="bi bi-chevron-right"></i>

                <span>
                    <%= mode === "edit" ? "Edit Service" : "Add Service" %>
                </span>

            </div>


            <form action="#" method="POST">


                <div class="row g-4">


                    <!-- LEFT -->

                    <div class="col-lg-8">


                        <!-- BASIC INFORMATION -->

                        <div class="admin-section-card mb-4">

                            <div class="admin-form-title">

                                <h5>
                                    Basic Information
                                </h5>

                                <p>
                                    Enter the main information about this citizen service.
                                </p>

                            </div>


                            <div class="mb-3">

                                <label class="form-label">
                                    Service Name
                                    <span class="text-danger">*</span>
                                </label>

                                <input
                                    type="text"
                                    class="form-control"
                                    placeholder="e.g. Birth Registration"
                                    value="<%= mode === 'edit' ? 'Birth Registration' : '' %>"
                                >

                            </div>


                            <div class="row g-3">


                                <div class="col-md-6">

                                    <label class="form-label">
                                        Category
                                        <span class="text-danger">*</span>
                                    </label>

                                    <select class="form-select">

                                        <option value="">
                                            Select Category
                                        </option>

                                        <option selected>
                                            Registration
                                        </option>

                                        <option>
                                            Recommendation
                                        </option>

                                        <option>
                                            Social Security
                                        </option>

                                        <option>
                                            Business
                                        </option>

                                        <option>
                                            Construction
                                        </option>

                                        <option>
                                            Other
                                        </option>

                                    </select>

                                </div>


                                <div class="col-md-6">

                                    <label class="form-label">
                                        Service Status
                                    </label>

                                    <select class="form-select">

                                        <option selected>
                                            Published
                                        </option>

                                        <option>
                                            Draft
                                        </option>

                                    </select>

                                </div>


                            </div>


                            <div class="mt-3">

                                <label class="form-label">
                                    Short Description
                                </label>

                                <textarea
                                    class="form-control"
                                    rows="3"
                                    placeholder="Write a short description of the service..."
                                ><%= mode === "edit" ? "Registration of birth and issuance of birth certificate." : "" %></textarea>

                            </div>


                            <div class="mt-3">

                                <label class="form-label">
                                    Full Service Description
                                </label>

                                <textarea
                                    class="form-control service-content-editor"
                                    rows="8"
                                    placeholder="Write detailed information about this service..."
                                ><%= mode === "edit" ? "Citizens can register a birth at the concerned ward office. Applicants should submit the required documents and complete the registration process." : "" %></textarea>

                            </div>

                        </div>


                        <!-- SERVICE DETAILS -->

                        <div class="admin-section-card mb-4">

                            <div class="admin-form-title">

                                <h5>
                                    Service Details
                                </h5>

                                <p>
                                    Add processing time, fee and office information.
                                </p>

                            </div>


                            <div class="row g-3">


                                <div class="col-md-6">

                                    <label class="form-label">
                                        Processing Time
                                    </label>

                                    <input
                                        type="text"
                                        class="form-control"
                                        placeholder="e.g. Same Day"
                                        value="<%= mode === 'edit' ? 'Same Day' : '' %>"
                                    >

                                </div>


                                <div class="col-md-6">

                                    <label class="form-label">
                                        Service Fee
                                    </label>

                                    <input
                                        type="text"
                                        class="form-control"
                                        placeholder="e.g. Free / Rs. 100"
                                        value="<%= mode === 'edit' ? 'Free' : '' %>"
                                    >

                                </div>


                                <div class="col-md-6">

                                    <label class="form-label">
                                        Service Office
                                    </label>

                                    <input
                                        type="text"
                                        class="form-control"
                                        placeholder="e.g. Ward Office"
                                        value="<%= mode === 'edit' ? 'Concerned Ward Office' : '' %>"
                                    >

                                </div>


                                <div class="col-md-6">

                                    <label class="form-label">
                                        Contact Number
                                    </label>

                                    <input
                                        type="text"
                                        class="form-control"
                                        placeholder="Office contact number"
                                    >

                                </div>


                            </div>

                        </div>


                        <!-- REQUIRED DOCUMENTS -->

                        <div class="admin-section-card mb-4">

                            <div class="admin-form-title">

                                <h5>
                                    Required Documents
                                </h5>

                                <p>
                                    List the documents citizens need to provide.
                                </p>

                            </div>


                            <div id="documentsContainer">


                                <div class="document-input-row mb-2">

                                    <div class="input-group">

                                        <span class="input-group-text">
                                            <i class="bi bi-file-earmark-text"></i>
                                        </span>

                                        <input
                                            type="text"
                                            class="form-control"
                                            placeholder="e.g. Parents' citizenship copy"
                                            value="<%= mode === 'edit' ? 'Parents citizenship copy' : '' %>"
                                        >

                                        <button
                                            type="button"
                                            class="btn btn-outline-danger"
                                            onclick="removeDocument(this)"
                                        >
                                            <i class="bi bi-trash"></i>
                                        </button>

                                    </div>

                                </div>


                                <div class="document-input-row mb-2">

                                    <div class="input-group">

                                        <span class="input-group-text">
                                            <i class="bi bi-file-earmark-text"></i>
                                        </span>

                                        <input
                                            type="text"
                                            class="form-control"
                                            placeholder="e.g. Hospital birth record"
                                            value="<%= mode === 'edit' ? 'Hospital birth record' : '' %>"
                                        >

                                        <button
                                            type="button"
                                            class="btn btn-outline-danger"
                                            onclick="removeDocument(this)"
                                        >
                                            <i class="bi bi-trash"></i>
                                        </button>

                                    </div>

                                </div>


                            </div>


                            <button
                                type="button"
                                class="btn btn-outline-primary btn-sm mt-2"
                                onclick="addDocument()"
                            >
                                <i class="bi bi-plus-lg me-1"></i>
                                Add Document
                            </button>

                        </div>


                        <!-- PROCESS STEPS -->

                        <div class="admin-section-card">

                            <div class="admin-form-title">

                                <h5>
                                    Service Process
                                </h5>

                                <p>
                                    Explain the steps citizens need to follow.
                                </p>

                            </div>


                            <div id="stepsContainer">


                                <div class="process-step-row mb-3">

                                    <div class="input-group">

                                        <span class="input-group-text">
                                            Step 1
                                        </span>

                                        <input
                                            type="text"
                                            class="form-control"
                                            placeholder="Enter process step..."
                                            value="<%= mode === 'edit' ? 'Visit the concerned ward office.' : '' %>"
                                        >

                                        <button
                                            type="button"
                                            class="btn btn-outline-danger"
                                            onclick="removeStep(this)"
                                        >
                                            <i class="bi bi-trash"></i>
                                        </button>

                                    </div>

                                </div>


                                <div class="process-step-row mb-3">

                                    <div class="input-group">

                                        <span class="input-group-text">
                                            Step 2
                                        </span>

                                        <input
                                            type="text"
                                            class="form-control"
                                            placeholder="Enter process step..."
                                            value="<%= mode === 'edit' ? 'Submit the required documents.' : '' %>"
                                        >

                                        <button
                                            type="button"
                                            class="btn btn-outline-danger"
                                            onclick="removeStep(this)"
                                        >
                                            <i class="bi bi-trash"></i>
                                        </button>

                                    </div>

                                </div>


                            </div>


                            <button
                                type="button"
                                class="btn btn-outline-primary btn-sm"
                                onclick="addStep()"
                            >
                                <i class="bi bi-plus-lg me-1"></i>
                                Add Process Step
                            </button>

                        </div>


                    </div>


                    <!-- RIGHT -->

                    <div class="col-lg-4">


                        <!-- PUBLISH -->

                        <div class="admin-section-card mb-4">

                            <div class="admin-form-title">

                                <h5>
                                    Publish Service
                                </h5>

                                <p>
                                    Control the visibility of this service.
                                </p>

                            </div>


                            <div class="notice-status-preview mb-3">

                                <div>

                                    <span>
                                        Current Status
                                    </span>

                                    <strong id="statusPreview">
                                        Published
                                    </strong>

                                </div>

                                <i class="bi bi-globe2"></i>

                            </div>


                            <select
                                class="form-select"
                                id="statusSelect"
                                onchange="updateStatusPreview()"
                            >

                                <option value="Published" selected>
                                    Published
                                </option>

                                <option value="Draft">
                                    Draft
                                </option>

                            </select>

                        </div>


                        <!-- ICON -->

                        <div class="admin-section-card mb-4">

                            <div class="admin-form-title">

                                <h5>
                                    Service Icon
                                </h5>

                                <p>
                                    Select an icon for this service.
                                </p>

                            </div>


                            <select class="form-select mb-3">

                                <option>
                                    Person Card
                                </option>

                                <option>
                                    File Text
                                </option>

                                <option>
                                    Building
                                </option>

                                <option>
                                    Shop
                                </option>

                                <option>
                                    Heart
                                </option>

                                <option>
                                    House
                                </option>

                            </select>


                            <div class="service-icon-preview">

                                <i class="bi bi-person-vcard"></i>

                            </div>

                        </div>


                        <!-- GUIDE -->

                        <div class="admin-section-card">

                            <div class="admin-form-title">

                                <h5>
                                    Publishing Guide
                                </h5>

                                <p>
                                    Important information
                                </p>

                            </div>


                            <div class="admin-guide-item">

                                <i class="bi bi-info-circle"></i>

                                <div>

                                    <strong>
                                        Use clear information
                                    </strong>

                                    <p>
                                        Write service information in simple language so citizens can understand it easily.
                                    </p>

                                </div>

                            </div>


                            <div class="admin-guide-item">

                                <i class="bi bi-file-earmark-check"></i>

                                <div>

                                    <strong>
                                        Check documents
                                    </strong>

                                    <p>
                                        Make sure all required documents are correctly listed.
                                    </p>

                                </div>

                            </div>


                            <div class="admin-guide-item">

                                <i class="bi bi-clock"></i>

                                <div>

                                    <strong>
                                        Processing time
                                    </strong>

                                    <p>
                                        Keep processing time accurate and updated.
                                    </p>

                                </div>

                            </div>


                        </div>


                    </div>

                </div>


                <!-- FORM BUTTONS -->

                <div class="d-flex justify-content-end gap-2 mt-4">

                    <a
                        href="/admin/services"
                        class="btn btn-outline-secondary"
                    >
                        Cancel
                    </a>

                    <button
                        type="submit"
                        class="btn btn-primary"
                        onclick="saveService(event)"
                    >

                        <i class="bi bi-check-lg me-1"></i>

                        <%= mode === "edit"
                            ? "Update Service"
                            : "Save Service"
                        %>

                    </button>

                </div>


            </form>

        </div>

    </main>

</div>


<script>

function toggleAdminSidebar() {

    document
        .querySelector(".admin-sidebar")
        .classList.toggle("show");

}


function updateStatusPreview() {

    const select =
        document.getElementById("statusSelect");

    const preview =
        document.getElementById("statusPreview");

    preview.textContent = select.value;

    if (select.value === "Published") {

        preview.style.color = "#198754";

    } else {

        preview.style.color = "#997404";

    }

}


function addDocument() {

    const container =
        document.getElementById("documentsContainer");

    const row =
        document.createElement("div");

    row.className =
        "document-input-row mb-2";

    row.innerHTML = `

        <div class="input-group">

            <span class="input-group-text">
                <i class="bi bi-file-earmark-text"></i>
            </span>

            <input
                type="text"
                class="form-control"
                placeholder="Enter required document..."
            >

            <button
                type="button"
                class="btn btn-outline-danger"
                onclick="removeDocument(this)"
            >
                <i class="bi bi-trash"></i>
            </button>

        </div>

    `;

    container.appendChild(row);

}


function removeDocument(button) {

    const row =
        button.closest(".document-input-row");

    row.remove();

}


function addStep() {

    const container =
        document.getElementById("stepsContainer");

    const count =
        container.querySelectorAll(".process-step-row").length + 1;

    const row =
        document.createElement("div");

    row.className =
        "process-step-row mb-3";

    row.innerHTML = `

        <div class="input-group">

            <span class="input-group-text">
                Step ${count}
            </span>

            <input
                type="text"
                class="form-control"
                placeholder="Enter process step..."
            >

            <button
                type="button"
                class="btn btn-outline-danger"
                onclick="removeStep(this)"
            >
                <i class="bi bi-trash"></i>
            </button>

        </div>

    `;

    container.appendChild(row);

}


function removeStep(button) {

    const row =
        button.closest(".process-step-row");

    row.remove();

}


function saveService(event) {

    event.preventDefault();

    alert(
        "Frontend demo only. Service data is not saved yet because the backend and database are not connected."
    );

}

</script>


</body>

</html>