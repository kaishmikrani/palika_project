<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= title %> | Bishnu Rural Municipality</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
        rel="stylesheet"
    >

    <link rel="stylesheet" href="/css/style.css">

</head>


<body>

<div class="admin-page">


    <!-- SIDEBAR -->

    <aside class="admin-sidebar">

        <div class="admin-brand">

            <div class="admin-brand-icon">
                <i class="bi bi-building"></i>
            </div>

            <div>

                <h5>Bishnu Palika</h5>

                <small>
                    Admin Panel
                </small>

            </div>

        </div>


        <div class="admin-menu-title">
            MAIN MENU
        </div>


        <nav class="admin-menu">

            <a href="/admin/dashboard" class="admin-menu-link">
                <i class="bi bi-grid-1x2-fill"></i>
                <span>Dashboard</span>
            </a>

            <a href="/admin/notices" class="admin-menu-link">
                <i class="bi bi-megaphone-fill"></i>
                <span>Notices</span>
            </a>

            <a href="/admin/news" class="admin-menu-link active">
                <i class="bi bi-newspaper"></i>
                <span>News & Events</span>
            </a>

            <a href="/admin/services" class="admin-menu-link">
                <i class="bi bi-person-workspace"></i>
                <span>Services</span>
            </a>

            <a href="/admin/wards" class="admin-menu-link">
                <i class="bi bi-geo-alt-fill"></i>
                <span>Wards</span>
            </a>

            <a href="/admin/downloads" class="admin-menu-link">
                <i class="bi bi-download"></i>
                <span>Downloads</span>
            </a>

            <a href="/admin/gallery" class="admin-menu-link">
                <i class="bi bi-images"></i>
                <span>Gallery</span>
            </a>

            <a href="/admin/slider" class="admin-menu-link">
                <i class="bi bi-sliders"></i>
                <span>Homepage Slider</span>
            </a>


            <div class="admin-menu-title">
                SETTINGS
            </div>

            <a href="/admin/profile" class="admin-menu-link">
                <i class="bi bi-person-circle"></i>
                <span>Profile</span>
            </a>

            <a href="/admin/settings" class="admin-menu-link">
                <i class="bi bi-gear-fill"></i>
                <span>Settings</span>
            </a>

            <a href="/" class="admin-menu-link" target="_blank">
                <i class="bi bi-globe"></i>
                <span>View Website</span>
            </a>

        </nav>


        <div class="admin-sidebar-bottom">

            <a href="/admin/login">

                <i class="bi bi-box-arrow-left"></i>

                <span>
                    Logout
                </span>

            </a>

        </div>

    </aside>


    <!-- MAIN -->

    <main class="admin-main">


        <!-- TOPBAR -->

        <header class="admin-topbar">

            <div class="d-flex align-items-center gap-3">

                <button
                    class="admin-mobile-menu"
                    onclick="toggleAdminSidebar()"
                >
                    <i class="bi bi-list"></i>
                </button>

                <div>

                    <h4>
                        <%= mode === "edit"
                            ? "Edit News & Event"
                            : "Add News & Event"
                        %>
                    </h4>

                    <p>
                        Create and publish website content
                    </p>

                </div>

            </div>


            <div class="admin-user">

                <div class="admin-user-icon">
                    <i class="bi bi-person-fill"></i>
                </div>

                <div>

                    <strong>
                        Administrator
                    </strong>

                    <small>
                        Super Admin
                    </small>

                </div>

            </div>

        </header>


        <!-- CONTENT -->

        <div class="admin-content">


            <!-- BREADCRUMB -->

            <div class="admin-breadcrumb mb-4">

                <a href="/admin/dashboard">
                    Dashboard
                </a>

                <i class="bi bi-chevron-right"></i>

                <a href="/admin/news">
                    News & Events
                </a>

                <i class="bi bi-chevron-right"></i>

                <span>
                    <%= mode === "edit" ? "Edit" : "Add" %>
                </span>

            </div>


            <div class="row g-4">


                <!-- LEFT -->

                <div class="col-lg-8">


                    <div class="admin-section-card">


                        <div class="admin-form-title">

                            <h5>
                                News & Event Information
                            </h5>

                            <p>
                                Enter the information that will appear on the website.
                            </p>

                        </div>


                        <form>


                            <!-- TITLE -->

                            <div class="mb-4">

                                <label class="form-label">
                                    News / Event Title
                                    <span class="text-danger">*</span>
                                </label>

                                <input
                                    type="text"
                                    class="form-control"
                                    placeholder="Enter news or event title"
                                    value="<%= mode === 'edit' ? 'Municipality Development Program' : '' %>"
                                >

                            </div>


                            <!-- CATEGORY + DATE -->

                            <div class="row g-3 mb-4">

                                <div class="col-md-6">

                                    <label class="form-label">
                                        Category
                                        <span class="text-danger">*</span>
                                    </label>

                                    <select class="form-select">

                                        <option>
                                            Select Category
                                        </option>

                                        <option
                                            <%= mode === "edit" ? "selected" : "" %>
                                        >
                                            News
                                        </option>

                                        <option>
                                            Event
                                        </option>

                                        <option>
                                            Development
                                        </option>

                                        <option>
                                            Announcement
                                        </option>

                                        <option>
                                            Program
                                        </option>

                                    </select>

                                </div>


                                <div class="col-md-6">

                                    <label class="form-label">
                                        Publication Date
                                        <span class="text-danger">*</span>
                                    </label>

                                    <input
                                        type="date"
                                        class="form-control"
                                        value="<%= mode === 'edit' ? '2026-09-12' : '' %>"
                                    >

                                </div>

                            </div>


                            <!-- AUTHOR -->

                            <div class="mb-4">

                                <label class="form-label">
                                    Author / Published By
                                </label>

                                <input
                                    type="text"
                                    class="form-control"
                                    placeholder="Enter author or department"
                                    value="<%= mode === 'edit' ? 'Bishnu Rural Municipality' : '' %>"
                                >

                            </div>


                            <!-- SHORT DESCRIPTION -->

                            <div class="mb-4">

                                <label class="form-label">
                                    Short Description
                                    <span class="text-danger">*</span>
                                </label>

                                <textarea
                                    class="form-control"
                                    rows="4"
                                    placeholder="Write a short summary of the news..."
                                ><%= mode === 'edit' ? 'Important information regarding municipality development activities and programs.' : '' %></textarea>

                                <small class="text-muted">
                                    This summary may appear on news cards.
                                </small>

                            </div>


                            <!-- FULL CONTENT -->

                            <div class="mb-4">

                                <label class="form-label">
                                    Full Content
                                    <span class="text-danger">*</span>
                                </label>

                                <textarea
                                    class="form-control news-content-editor"
                                    rows="10"
                                    placeholder="Write the complete news or event details..."
                                ><%= mode === 'edit' ? 'Write complete news and event information here. This section will contain the full content displayed on the news details page.' : '' %></textarea>

                            </div>


                            <!-- FEATURED -->

                            <div class="admin-featured-box mb-4">

                                <div>

                                    <strong>
                                        Feature this news
                                    </strong>

                                    <p>
                                        Featured news can be displayed prominently on the homepage.
                                    </p>

                                </div>

                                <div class="form-check form-switch">

                                    <input
                                        class="form-check-input"
                                        type="checkbox"
                                        id="featuredNews"
                                        <%= mode === "edit" ? "checked" : "" %>
                                    >

                                    <label
                                        class="form-check-label"
                                        for="featuredNews"
                                    >
                                        Featured
                                    </label>

                                </div>

                            </div>


                            <!-- BUTTONS -->

                            <div class="d-flex gap-2">

                                <button
                                    type="button"
                                    class="btn btn-primary"
                                >

                                    <i class="bi bi-check-lg me-1"></i>

                                    <%= mode === "edit"
                                        ? "Update News"
                                        : "Save News"
                                    %>

                                </button>


                                <a
                                    href="/admin/news"
                                    class="btn btn-outline-secondary"
                                >
                                    Cancel
                                </a>

                            </div>


                        </form>

                    </div>

                </div>


                <!-- RIGHT -->

                <div class="col-lg-4">


                    <!-- IMAGE -->

                    <div class="admin-section-card mb-4">

                        <div class="admin-form-title">

                            <h5>
                                Featured Image
                            </h5>

                            <p>
                                Upload an image for this news.
                            </p>

                        </div>


                        <div class="admin-news-image-upload">


                            <% if (mode === "edit") { %>

                                <img
                                    src="/images/news-1.jpg"
                                    alt="Current News Image"
                                    id="newsImagePreview"
                                    class="news-image-preview"
                                >

                            <% } else { %>

                                <div
                                    class="news-image-placeholder"
                                    id="newsImagePlaceholder"
                                >

                                    <i class="bi bi-image"></i>

                                    <h6>
                                        No Image Selected
                                    </h6>

                                    <p>
                                        Choose an image below
                                    </p>

                                </div>

                            <% } %>


                            <input
                                type="file"
                                class="form-control mt-3"
                                id="newsImage"
                                accept="image/*"
                            >


                            <small class="text-muted d-block mt-2">
                                Recommended: JPG or PNG, maximum 2 MB.
                            </small>

                        </div>

                    </div>


                    <!-- STATUS -->

                    <div class="admin-section-card mb-4">

                        <div class="admin-form-title">

                            <h5>
                                Publishing
                            </h5>

                            <p>
                                Control the visibility of this content.
                            </p>

                        </div>


                        <label class="form-label">
                            Status
                        </label>

                        <select class="form-select mb-3">

                            <option>
                                Draft
                            </option>

                            <option
                                <%= mode === "edit" ? "selected" : "" %>
                            >
                                Published
                            </option>

                        </select>


                        <div class="notice-status-preview">

                            <div>

                                <span>
                                    Current Status
                                </span>

                                <strong>
                                    <%= mode === "edit"
                                        ? "Published"
                                        : "Draft"
                                    %>
                                </strong>

                            </div>

                            <i class="bi bi-globe2"></i>

                        </div>

                    </div>


                    <!-- GUIDE -->

                    <div class="admin-section-card">

                        <div class="admin-form-title">

                            <h5>
                                Publishing Guide
                            </h5>

                            <p>
                                Helpful tips for administrators.
                            </p>

                        </div>


                        <div class="admin-guide-item">

                            <i class="bi bi-image"></i>

                            <div>

                                <strong>
                                    Use quality images
                                </strong>

                                <p>
                                    Use clear images related to the news or event.
                                </p>

                            </div>

                        </div>


                        <div class="admin-guide-item">

                            <i class="bi bi-text-paragraph"></i>

                            <div>

                                <strong>
                                    Keep titles clear
                                </strong>

                                <p>
                                    Use short and meaningful titles.
                                </p>

                            </div>

                        </div>


                        <div class="admin-guide-item">

                            <i class="bi bi-star"></i>

                            <div>

                                <strong>
                                    Use Featured carefully
                                </strong>

                                <p>
                                    Feature only important news on the homepage.
                                </p>

                            </div>

                        </div>


                        <div class="admin-guide-item">

                            <i class="bi bi-check-circle"></i>

                            <div>

                                <strong>
                                    Review before publishing
                                </strong>

                                <p>
                                    Check spelling and information before publishing.
                                </p>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </main>

</div>


<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>


<script>

function toggleAdminSidebar() {

    document
        .querySelector(".admin-sidebar")
        .classList.toggle("show");

}


// IMAGE PREVIEW

const newsImage = document.getElementById("newsImage");

if (newsImage) {

    newsImage.addEventListener("change", function () {

        const file = this.files[0];

        if (!file) {
            return;
        }

        const reader = new FileReader();

        reader.onload = function (event) {

            let preview =
                document.getElementById("newsImagePreview");

            const placeholder =
                document.getElementById("newsImagePlaceholder");


            if (placeholder) {
                placeholder.style.display = "none";
            }


            if (!preview) {

                preview = document.createElement("img");

                preview.id = "newsImagePreview";

                preview.className =
                    "news-image-preview";

                document
                    .querySelector(".admin-news-image-upload")
                    .prepend(preview);

            }


            preview.src = event.target.result;

        };


        reader.readAsDataURL(file);

    });

}

</script>

</body>

</html>