
<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= title %> | Bishnu Rural Municipality</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

</head>


<body class="admin-page">


<!-- SIDEBAR -->

<aside class="admin-sidebar">

    <div class="admin-brand">

        <div class="admin-brand-icon">
            <i class="bi bi-building-fill"></i>
        </div>

        <div>

            <h5>Bishnu Rural</h5>

            <small>Administration</small>

        </div>

    </div>


    <div class="admin-menu-title">
        MAIN MENU
    </div>


    <nav class="admin-menu">

        <a
            href="/admin/dashboard"
            class="admin-menu-link"
        >
            <i class="bi bi-speedometer2"></i>
            <span>Dashboard</span>
        </a>


        <a
            href="/admin/notices"
            class="admin-menu-link active"
        >
            <i class="bi bi-megaphone"></i>
            <span>Notices</span>
        </a>


        <a
            href="/admin/news"
            class="admin-menu-link"
        >
            <i class="bi bi-newspaper"></i>
            <span>News & Events</span>
        </a>


        <a
            href="/admin/services"
            class="admin-menu-link"
        >
            <i class="bi bi-grid"></i>
            <span>Services</span>
        </a>


        <a
            href="/admin/wards"
            class="admin-menu-link"
        >
            <i class="bi bi-diagram-3"></i>
            <span>Wards</span>
        </a>


        <a
            href="/admin/downloads"
            class="admin-menu-link"
        >
            <i class="bi bi-file-earmark-arrow-down"></i>
            <span>Downloads</span>
        </a>


        <a
            href="/admin/gallery"
            class="admin-menu-link"
        >
            <i class="bi bi-images"></i>
            <span>Gallery</span>
        </a>


        <a
            href="/admin/slider"
            class="admin-menu-link"
        >
            <i class="bi bi-images"></i>
            <span>Homepage Slider</span>
        </a>


        <div class="admin-menu-title mt-4">
            SYSTEM
        </div>


        <a href="#" class="admin-menu-link">
            <i class="bi bi-person-gear"></i>
            <span>Profile</span>
        </a>


        <a href="#" class="admin-menu-link">
            <i class="bi bi-gear"></i>
            <span>Settings</span>
        </a>


        <a href="/" class="admin-menu-link">
            <i class="bi bi-globe"></i>
            <span>View Website</span>
        </a>

    </nav>


    <div class="admin-sidebar-bottom">

        <a href="/admin/login">

            <i class="bi bi-box-arrow-right"></i>

            Logout

        </a>

    </div>

</aside>



<!-- MAIN -->

<main class="admin-main">


    <!-- TOPBAR -->

    <header class="admin-topbar">

        <button
            class="admin-mobile-menu"
            onclick="toggleAdminSidebar()"
        >
            <i class="bi bi-list"></i>
        </button>


        <div>

            <h4>
                Notices
            </h4>

            <p>
                Manage municipality notices
            </p>

        </div>


        <div class="admin-user">

            <div class="admin-user-icon">

                <i class="bi bi-person-fill"></i>

            </div>

            <div class="d-none d-sm-block">

                <strong>Administrator</strong>

                <small>Admin</small>

            </div>

        </div>

    </header>



    <!-- CONTENT -->

    <div class="admin-content">


        <!-- PAGE HEADER -->

        <div class="admin-page-header">

            <div>

                <h3>
                    Notice Management
                </h3>

                <p>
                    Create, update and manage published notices.
                </p>

            </div>


            <a
                href="/admin/notices/add"
                class="btn btn-primary"
            >

                <i class="bi bi-plus-lg me-2"></i>

                Add Notice

            </a>

        </div>



        <!-- FILTER -->

        <div class="admin-section-card mb-4">

            <div class="row g-3 align-items-end">


                <div class="col-lg-5">

                    <label class="form-label">
                        Search Notice
                    </label>

                    <div class="admin-search">

                        <i class="bi bi-search"></i>

                        <input
                            type="text"
                            class="form-control"
                            placeholder="Search notices..."
                        >

                    </div>

                </div>


                <div class="col-md-4 col-lg-3">

                    <label class="form-label">
                        Category
                    </label>

                    <select class="form-select">

                        <option>
                            All Categories
                        </option>

                        <option>
                            Public Notice
                        </option>

                        <option>
                            Tender
                        </option>

                        <option>
                            Vacancy
                        </option>

                        <option>
                            Important Information
                        </option>

                    </select>

                </div>


                <div class="col-md-4 col-lg-2">

                    <label class="form-label">
                        Status
                    </label>

                    <select class="form-select">

                        <option>
                            All Status
                        </option>

                        <option>
                            Published
                        </option>

                        <option>
                            Draft
                        </option>

                    </select>

                </div>


                <div class="col-md-4 col-lg-2">

                    <button
                        class="btn btn-outline-primary w-100"
                    >

                        <i class="bi bi-funnel me-1"></i>

                        Filter

                    </button>

                </div>

            </div>

        </div>



        <!-- NOTICE TABLE -->

        <div class="admin-section-card">


            <div class="admin-section-header">

                <div>

                    <h5>
                        All Notices
                    </h5>

                    <p>
                        24 notices found
                    </p>

                </div>


                <button
                    class="btn btn-sm btn-outline-secondary"
                >

                    <i class="bi bi-download me-1"></i>

                    Export

                </button>

            </div>



            <div class="table-responsive">

                <table class="table admin-management-table">

                    <thead>

                        <tr>

                            <th width="45">
                                #
                            </th>

                            <th>
                                Notice
                            </th>

                            <th>
                                Category
                            </th>

                            <th>
                                Published Date
                            </th>

                            <th>
                                Status
                            </th>

                            <th class="text-end">
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody>


                        <!-- ROW 1 -->

                        <tr>

                            <td>
                                01
                            </td>

                            <td>

                                <div class="notice-admin-title">

                                    <strong>
                                        Public Notice Regarding
                                        Municipal Services
                                    </strong>

                                    <small>
                                        Notice ID: NT-001
                                    </small>

                                </div>

                            </td>

                            <td>

                                <span class="badge bg-primary-subtle text-primary">
                                    Public Notice
                                </span>

                            </td>

                            <td>
                                12 Sep 2026
                            </td>

                            <td>

                                <span class="status-badge published">
                                    Published
                                </span>

                            </td>

                            <td>

                                <div class="admin-actions">

                                    <a
                                        href="/notices/1"
                                        class="btn btn-sm btn-light"
                                        title="View"
                                    >
                                        <i class="bi bi-eye"></i>
                                    </a>


                                    <a
                                        href="/admin/notices/edit/1"
                                        class="btn btn-sm btn-light"
                                        title="Edit"
                                    >
                                        <i class="bi bi-pencil"></i>
                                    </a>


                                    <button
                                        class="btn btn-sm btn-light text-danger"
                                        title="Delete"
                                    >
                                        <i class="bi bi-trash"></i>
                                    </button>

                                </div>

                            </td>

                        </tr>



                        <!-- ROW 2 -->

                        <tr>

                            <td>
                                02
                            </td>

                            <td>

                                <div class="notice-admin-title">

                                    <strong>
                                        Information Regarding
                                        Citizen Services
                                    </strong>

                                    <small>
                                        Notice ID: NT-002
                                    </small>

                                </div>

                            </td>

                            <td>

                                <span class="badge bg-success-subtle text-success">
                                    Information
                                </span>

                            </td>

                            <td>
                                10 Sep 2026
                            </td>

                            <td>

                                <span class="status-badge published">
                                    Published
                                </span>

                            </td>

                            <td>

                                <div class="admin-actions">

                                    <a
                                        href="/notices/2"
                                        class="btn btn-sm btn-light"
                                    >
                                        <i class="bi bi-eye"></i>
                                    </a>

                                    <a
                                        href="/admin/notices/edit/2"
                                        class="btn btn-sm btn-light"
                                    >
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    <button
                                        class="btn btn-sm btn-light text-danger"
                                    >
                                        <i class="bi bi-trash"></i>
                                    </button>

                                </div>

                            </td>

                        </tr>



                        <!-- ROW 3 -->

                        <tr>

                            <td>
                                03
                            </td>

                            <td>

                                <div class="notice-admin-title">

                                    <strong>
                                        Municipal Tender Announcement
                                    </strong>

                                    <small>
                                        Notice ID: NT-003
                                    </small>

                                </div>

                            </td>

                            <td>

                                <span class="badge bg-warning-subtle text-warning-emphasis">
                                    Tender
                                </span>

                            </td>

                            <td>
                                08 Sep 2026
                            </td>

                            <td>

                                <span class="status-badge published">
                                    Published
                                </span>

                            </td>

                            <td>

                                <div class="admin-actions">

                                    <a
                                        href="/notices/3"
                                        class="btn btn-sm btn-light"
                                    >
                                        <i class="bi bi-eye"></i>
                                    </a>

                                    <a
                                        href="/admin/notices/edit/3"
                                        class="btn btn-sm btn-light"
                                    >
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    <button
                                        class="btn btn-sm btn-light text-danger"
                                    >
                                        <i class="bi bi-trash"></i>
                                    </button>

                                </div>

                            </td>

                        </tr>



                        <!-- ROW 4 -->

                        <tr>

                            <td>
                                04
                            </td>

                            <td>

                                <div class="notice-admin-title">

                                    <strong>
                                        Important Office Announcement
                                    </strong>

                                    <small>
                                        Notice ID: NT-004
                                    </small>

                                </div>

                            </td>

                            <td>

                                <span class="badge bg-danger-subtle text-danger">
                                    Important
                                </span>

                            </td>

                            <td>
                                05 Sep 2026
                            </td>

                            <td>

                                <span class="status-badge draft">
                                    Draft
                                </span>

                            </td>

                            <td>

                                <div class="admin-actions">

                                    <a
                                        href="/notices/4"
                                        class="btn btn-sm btn-light"
                                    >
                                        <i class="bi bi-eye"></i>
                                    </a>

                                    <a
                                        href="/admin/notices/edit/4"
                                        class="btn btn-sm btn-light"
                                    >
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    <button
                                        class="btn btn-sm btn-light text-danger"
                                    >
                                        <i class="bi bi-trash"></i>
                                    </button>

                                </div>

                            </td>

                        </tr>


                    </tbody>

                </table>

            </div>



            <!-- PAGINATION -->

            <div class="admin-pagination">

                <span>
                    Showing 1–4 of 24 notices
                </span>


                <nav>

                    <ul class="pagination mb-0">

                        <li class="page-item disabled">

                            <a class="page-link" href="#">
                                Previous
                            </a>

                        </li>

                        <li class="page-item active">

                            <a class="page-link" href="#">
                                1
                            </a>

                        </li>

                        <li class="page-item">

                            <a class="page-link" href="#">
                                2
                            </a>

                        </li>

                        <li class="page-item">

                            <a class="page-link" href="#">
                                3
                            </a>

                        </li>

                        <li class="page-item">

                            <a class="page-link" href="#">
                                Next
                            </a>

                        </li>

                    </ul>

                </nav>

            </div>


        </div>


    </div>

</main>



<script>

function toggleAdminSidebar() {

    document
        .querySelector(".admin-sidebar")
        .classList.toggle("show");

}

</script>


</body>

</html>
