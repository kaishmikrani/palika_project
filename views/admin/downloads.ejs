<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= title || "Manage Downloads" %></title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
        rel="stylesheet"
    >

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<div class="admin-page">

    <!-- ================= SIDEBAR ================= -->
    <aside class="admin-sidebar">

        <div class="admin-brand">
            <div class="admin-brand-icon">
                <i class="bi bi-building"></i>
            </div>

            <div>
                <h5>Bishnu Palika</h5>
                <small>Admin Panel</small>
            </div>
        </div>

        <div class="admin-menu-title">MAIN MENU</div>

        <nav class="admin-menu">

            <a href="/admin/dashboard" class="admin-menu-link">
                <i class="bi bi-grid-1x2-fill"></i>
                <span>Dashboard</span>
            </a>

            <a href="/admin/notices" class="admin-menu-link">
                <i class="bi bi-megaphone-fill"></i>
                <span>Notices</span>
            </a>

            <a href="/admin/news" class="admin-menu-link">
                <i class="bi bi-newspaper"></i>
                <span>News & Events</span>
            </a>

            <a href="/admin/services" class="admin-menu-link">
                <i class="bi bi-person-workspace"></i>
                <span>Services</span>
            </a>

            <a href="/admin/wards" class="admin-menu-link">
                <i class="bi bi-geo-alt-fill"></i>
                <span>Wards</span>
            </a>

            <a href="/admin/downloads" class="admin-menu-link active">
                <i class="bi bi-download"></i>
                <span>Downloads</span>
            </a>

            <a href="/admin/gallery" class="admin-menu-link">
                <i class="bi bi-images"></i>
                <span>Gallery</span>
            </a>

            <a href="/admin/slider" class="admin-menu-link">
                <i class="bi bi-sliders"></i>
                <span>Homepage Slider</span>
            </a>

            <div class="admin-menu-title">SETTINGS</div>

            <a href="/admin/profile" class="admin-menu-link">
                <i class="bi bi-person-circle"></i>
                <span>Profile</span>
            </a>

            <a href="/admin/settings" class="admin-menu-link">
                <i class="bi bi-gear-fill"></i>
                <span>Settings</span>
            </a>

            <a href="/" target="_blank" class="admin-menu-link">
                <i class="bi bi-globe"></i>
                <span>View Website</span>
            </a>

        </nav>

        <div class="admin-sidebar-bottom">
            <a href="/admin/login">
                <i class="bi bi-box-arrow-left"></i>
                <span>Logout</span>
            </a>
        </div>

    </aside>


    <!-- ================= MAIN ================= -->
    <main class="admin-main">

        <!-- TOPBAR -->
        <div class="admin-topbar">

            <div class="d-flex align-items-center gap-3">

                <button
                    type="button"
                    class="admin-mobile-menu"
                    onclick="toggleAdminSidebar()"
                >
                    <i class="bi bi-list"></i>
                </button>

                <div>
                    <h4>Downloads</h4>
                    <p>Manage downloadable documents and files</p>
                </div>

            </div>

            <div class="admin-user">

                <div class="admin-user-icon">
                    <i class="bi bi-person-fill"></i>
                </div>

                <div class="d-none d-sm-block">
                    <strong>Administrator</strong>
                    <small>Super Admin</small>
                </div>

            </div>

        </div>


        <!-- CONTENT -->
        <div class="admin-content">

            <!-- Breadcrumb -->
            <div class="admin-breadcrumb mb-4">

                <a href="/admin/dashboard">
                    Dashboard
                </a>

                <i class="bi bi-chevron-right"></i>

                <span>Downloads</span>

            </div>


            <!-- PAGE HEADER -->
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

                <div>
                    <h4 class="fw-bold mb-1">
                        Download Documents
                    </h4>

                    <p class="text-muted mb-0">
                        Add and manage documents available for citizens.
                    </p>
                </div>

                <a href="/admin/downloads/add" class="btn btn-primary">
                    <i class="bi bi-plus-lg me-1"></i>
                    Add Download
                </a>

            </div>


            <!-- ================= STATS ================= -->
            <div class="row g-4 mb-4">

                <!-- Total -->
                <div class="col-xl-3 col-md-6">

                    <div class="admin-stat-card">

                        <div class="admin-stat-icon bg-primary-subtle text-primary">
                            <i class="bi bi-files"></i>
                        </div>

                        <div>
                            <small class="text-muted">
                                Total Files
                            </small>

                            <h4 class="fw-bold mb-0">
                                28
                            </h4>
                        </div>

                    </div>

                </div>


                <!-- Published -->
                <div class="col-xl-3 col-md-6">

                    <div class="admin-stat-card">

                        <div class="admin-stat-icon bg-success-subtle text-success">
                            <i class="bi bi-check-circle"></i>
                        </div>

                        <div>
                            <small class="text-muted">
                                Published
                            </small>

                            <h4 class="fw-bold mb-0">
                                24
                            </h4>
                        </div>

                    </div>

                </div>


                <!-- Draft -->
                <div class="col-xl-3 col-md-6">

                    <div class="admin-stat-card">

                        <div class="admin-stat-icon bg-warning-subtle text-warning">
                            <i class="bi bi-file-earmark-text"></i>
                        </div>

                        <div>
                            <small class="text-muted">
                                Draft
                            </small>

                            <h4 class="fw-bold mb-0">
                                4
                            </h4>
                        </div>

                    </div>

                </div>


                <!-- Categories -->
                <div class="col-xl-3 col-md-6">

                    <div class="admin-stat-card">

                        <div class="admin-stat-icon bg-info-subtle text-info">
                            <i class="bi bi-folder2-open"></i>
                        </div>

                        <div>
                            <small class="text-muted">
                                Categories
                            </small>

                            <h4 class="fw-bold mb-0">
                                7
                            </h4>
                        </div>

                    </div>

                </div>

            </div>


            <!-- ================= FILTERS ================= -->
            <div class="admin-section-card mb-4">

                <div class="admin-section-header">

                    <div>
                        <h5>
                            Search & Filter
                        </h5>

                        <p>
                            Find documents quickly.
                        </p>
                    </div>

                </div>


                <div class="row g-3">

                    <!-- Search -->
                    <div class="col-lg-4">

                        <label class="form-label">
                            Search Document
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                <i class="bi bi-search"></i>
                            </span>

                            <input
                                type="text"
                                class="form-control"
                                placeholder="Search by title..."
                            >

                        </div>

                    </div>


                    <!-- Category -->
                    <div class="col-md-4 col-lg-2">

                        <label class="form-label">
                            Category
                        </label>

                        <select class="form-select">

                            <option value="">
                                All Categories
                            </option>

                            <option>
                                Forms
                            </option>

                            <option>
                                Budget
                            </option>

                            <option>
                                Policies
                            </option>

                            <option>
                                Reports
                            </option>

                            <option>
                                Procurement
                            </option>

                            <option>
                                Citizen Charter
                            </option>

                            <option>
                                Other
                            </option>

                        </select>

                    </div>


                    <!-- File Type -->
                    <div class="col-md-4 col-lg-2">

                        <label class="form-label">
                            File Type
                        </label>

                        <select class="form-select">

                            <option value="">
                                All Types
                            </option>

                            <option>
                                PDF
                            </option>

                            <option>
                                DOCX
                            </option>

                            <option>
                                XLSX
                            </option>

                            <option>
                                JPG
                            </option>

                            <option>
                                Other
                            </option>

                        </select>

                    </div>


                    <!-- Status -->
                    <div class="col-md-4 col-lg-2">

                        <label class="form-label">
                            Status
                        </label>

                        <select class="form-select">

                            <option value="">
                                All Status
                            </option>

                            <option>
                                Published
                            </option>

                            <option>
                                Draft
                            </option>

                        </select>

                    </div>


                    <!-- Button -->
                    <div class="col-md-4 col-lg-2 d-flex align-items-end">

                        <button
                            type="button"
                            class="btn btn-outline-secondary w-100"
                            onclick="alert('Frontend demo: filters will work after backend integration.')"
                        >
                            <i class="bi bi-funnel me-1"></i>
                            Apply Filter
                        </button>

                    </div>

                </div>

            </div>


            <!-- ================= TABLE ================= -->
            <div class="admin-section-card">

                <div class="admin-section-header">

                    <div>
                        <h5>
                            Documents
                        </h5>

                        <p>
                            Manage all downloadable files.
                        </p>
                    </div>

                    <span class="badge bg-light text-dark border">
                        28 Documents
                    </span>

                </div>


                <div class="table-responsive">

                    <table class="table admin-management-table align-middle">

                        <thead>

                            <tr>

                                <th>
                                    Document
                                </th>

                                <th>
                                    Category
                                </th>

                                <th>
                                    File Type
                                </th>

                                <th>
                                    Published Date
                                </th>

                                <th>
                                    Downloads
                                </th>

                                <th>
                                    Status
                                </th>

                                <th class="text-end">
                                    Actions
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            <!-- ROW 1 -->
                            <tr>

                                <td>

                                    <div class="download-admin-item">

                                        <div class="download-file-icon pdf">
                                            <i class="bi bi-file-earmark-pdf-fill"></i>
                                        </div>

                                        <div>
                                            <strong>
                                                Annual Budget 2082/83
                                            </strong>

                                            <small>
                                                Annual budget document
                                            </small>
                                        </div>

                                    </div>

                                </td>

                                <td>
                                    <span class="admin-category-badge">
                                        Budget
                                    </span>
                                </td>

                                <td>
                                    <span class="file-type-badge pdf-badge">
                                        PDF
                                    </span>
                                </td>

                                <td>
                                    15 Aug 2025
                                </td>

                                <td>
                                    <strong>1,284</strong>
                                </td>

                                <td>
                                    <span class="badge bg-success-subtle text-success">
                                        Published
                                    </span>
                                </td>

                                <td>

                                    <div class="admin-actions">

                                        <a
                                            href="/downloads"
                                            target="_blank"
                                            class="btn btn-sm btn-outline-primary"
                                            title="View"
                                        >
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <a
                                            href="/admin/downloads/edit/1"
                                            class="btn btn-sm btn-outline-secondary"
                                            title="Edit"
                                        >
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <button
                                            type="button"
                                            class="btn btn-sm btn-outline-danger"
                                            onclick="deleteDownload('Annual Budget 2082/83')"
                                            title="Delete"
                                        >
                                            <i class="bi bi-trash"></i>
                                        </button>

                                    </div>

                                </td>

                            </tr>


                            <!-- ROW 2 -->
                            <tr>

                                <td>

                                    <div class="download-admin-item">

                                        <div class="download-file-icon pdf">
                                            <i class="bi bi-file-earmark-pdf-fill"></i>
                                        </div>

                                        <div>
                                            <strong>
                                                Citizen Charter
                                            </strong>

                                            <small>
                                                Citizen service information
                                            </small>
                                        </div>

                                    </div>

                                </td>

                                <td>
                                    <span class="admin-category-badge">
                                        Citizen Charter
                                    </span>
                                </td>

                                <td>
                                    <span class="file-type-badge pdf-badge">
                                        PDF
                                    </span>
                                </td>

                                <td>
                                    10 Aug 2025
                                </td>

                                <td>
                                    <strong>2,541</strong>
                                </td>

                                <td>
                                    <span class="badge bg-success-subtle text-success">
                                        Published
                                    </span>
                                </td>

                                <td>

                                    <div class="admin-actions">

                                        <a
                                            href="/downloads"
                                            target="_blank"
                                            class="btn btn-sm btn-outline-primary"
                                        >
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <a
                                            href="/admin/downloads/edit/2"
                                            class="btn btn-sm btn-outline-secondary"
                                        >
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <button
                                            type="button"
                                            class="btn btn-sm btn-outline-danger"
                                            onclick="deleteDownload('Citizen Charter')"
                                        >
                                            <i class="bi bi-trash"></i>
                                        </button>

                                    </div>

                                </td>

                            </tr>


                            <!-- ROW 3 -->
                            <tr>

                                <td>

                                    <div class="download-admin-item">

                                        <div class="download-file-icon docx">
                                            <i class="bi bi-file-earmark-word-fill"></i>
                                        </div>

                                        <div>
                                            <strong>
                                                Application Form
                                            </strong>

                                            <small>
                                                General application form
                                            </small>
                                        </div>

                                    </div>

                                </td>

                                <td>
                                    <span class="admin-category-badge">
                                        Forms
                                    </span>
                                </td>

                                <td>
                                    <span class="file-type-badge docx-badge">
                                        DOCX
                                    </span>
                                </td>

                                <td>
                                    05 Aug 2025
                                </td>

                                <td>
                                    <strong>876</strong>
                                </td>

                                <td>
                                    <span class="badge bg-success-subtle text-success">
                                        Published
                                    </span>
                                </td>

                                <td>

                                    <div class="admin-actions">

                                        <a
                                            href="/downloads"
                                            target="_blank"
                                            class="btn btn-sm btn-outline-primary"
                                        >
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <a
                                            href="/admin/downloads/edit/3"
                                            class="btn btn-sm btn-outline-secondary"
                                        >
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <button
                                            type="button"
                                            class="btn btn-sm btn-outline-danger"
                                            onclick="deleteDownload('Application Form')"
                                        >
                                            <i class="bi bi-trash"></i>
                                        </button>

                                    </div>

                                </td>

                            </tr>


                            <!-- ROW 4 -->
                            <tr>

                                <td>

                                    <div class="download-admin-item">

                                        <div class="download-file-icon pdf">
                                            <i class="bi bi-file-earmark-pdf-fill"></i>
                                        </div>

                                        <div>
                                            <strong>
                                                Procurement Notice
                                            </strong>

                                            <small>
                                                Procurement related document
                                            </small>
                                        </div>

                                    </div>

                                </td>

                                <td>
                                    <span class="admin-category-badge">
                                        Procurement
                                    </span>
                                </td>

                                <td>
                                    <span class="file-type-badge pdf-badge">
                                        PDF
                                    </span>
                                </td>

                                <td>
                                    01 Aug 2025
                                </td>

                                <td>
                                    <strong>653</strong>
                                </td>

                                <td>
                                    <span class="badge bg-success-subtle text-success">
                                        Published
                                    </span>
                                </td>

                                <td>

                                    <div class="admin-actions">

                                        <a
                                            href="/downloads"
                                            target="_blank"
                                            class="btn btn-sm btn-outline-primary"
                                        >
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <a
                                            href="/admin/downloads/edit/4"
                                            class="btn btn-sm btn-outline-secondary"
                                        >
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <button
                                            type="button"
                                            class="btn btn-sm btn-outline-danger"
                                            onclick="deleteDownload('Procurement Notice')"
                                        >
                                            <i class="bi bi-trash"></i>
                                        </button>

                                    </div>

                                </td>

                            </tr>


                            <!-- ROW 5 -->
                            <tr>

                                <td>

                                    <div class="download-admin-item">

                                        <div class="download-file-icon pdf">
                                            <i class="bi bi-file-earmark-pdf-fill"></i>
                                        </div>

                                        <div>
                                            <strong>
                                                Social Security Form
                                            </strong>

                                            <small>
                                                Social security application form
                                            </small>
                                        </div>

                                    </div>

                                </td>

                                <td>
                                    <span class="admin-category-badge">
                                        Forms
                                    </span>
                                </td>

                                <td>
                                    <span class="file-type-badge pdf-badge">
                                        PDF
                                    </span>
                                </td>

                                <td>
                                    28 Jul 2025
                                </td>

                                <td>
                                    <strong>1,047</strong>
                                </td>

                                <td>
                                    <span class="badge bg-warning-subtle text-warning-emphasis">
                                        Draft
                                    </span>
                                </td>

                                <td>

                                    <div class="admin-actions">

                                        <a
                                            href="/downloads"
                                            target="_blank"
                                            class="btn btn-sm btn-outline-primary"
                                        >
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <a
                                            href="/admin/downloads/edit/5"
                                            class="btn btn-sm btn-outline-secondary"
                                        >
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <button
                                            type="button"
                                            class="btn btn-sm btn-outline-danger"
                                            onclick="deleteDownload('Social Security Form')"
                                        >
                                            <i class="bi bi-trash"></i>
                                        </button>

                                    </div>

                                </td>

                            </tr>

                        </tbody>

                    </table>

                </div>


                <!-- PAGINATION -->
                <div class="admin-pagination">

                    <div>
                        Showing <strong>1–5</strong> of
                        <strong>28</strong> documents
                    </div>

                    <nav>

                        <ul class="pagination pagination-sm mb-0">

                            <li class="page-item disabled">
                                <a class="page-link" href="#">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>

                            <li class="page-item active">
                                <a class="page-link" href="#">
                                    1
                                </a>
                            </li>

                            <li class="page-item">
                                <a class="page-link" href="#">
                                    2
                                </a>
                            </li>

                            <li class="page-item">
                                <a class="page-link" href="#">
                                    3
                                </a>
                            </li>

                            <li class="page-item">
                                <a class="page-link" href="#">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>

                        </ul>

                    </nav>

                </div>

            </div>


            <!-- DEMO NOTICE -->
            <div class="alert alert-info mt-4 mb-0">

                <i class="bi bi-info-circle me-2"></i>

                <strong>Frontend Demo:</strong>
                Documents, download counts, filters, and delete actions are
                currently static. They will become dynamic after backend and
                database integration.

            </div>

        </div>

    </main>

</div>


<script>

function toggleAdminSidebar() {
    document
        .querySelector(".admin-sidebar")
        .classList.toggle("show");
}


function deleteDownload(title) {

    const confirmed = confirm(
        `Are you sure you want to delete "${title}"?`
    );

    if (confirmed) {

        alert(
            "Frontend demo: this document would be deleted after backend integration."
        );

    }

}

</script>


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>