<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= title || "Add Slider" %></title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
        rel="stylesheet"
    >

    <link rel="stylesheet" href="/css/style.css">

</head>

<body>

<div class="admin-page">


    <!-- =====================================================
         SIDEBAR
    ====================================================== -->

    <aside class="admin-sidebar">

        <div class="admin-brand">

            <div class="admin-brand-icon">
                <i class="bi bi-building"></i>
            </div>

            <div>
                <h5>Bishnu Palika</h5>
                <small>Admin Panel</small>
            </div>

        </div>


        <div class="admin-menu-title">
            MAIN MENU
        </div>


        <nav class="admin-menu">

            <a href="/admin/dashboard" class="admin-menu-link">
                <i class="bi bi-grid-1x2-fill"></i>
                <span>Dashboard</span>
            </a>

            <a href="/admin/notices" class="admin-menu-link">
                <i class="bi bi-megaphone-fill"></i>
                <span>Notices</span>
            </a>

            <a href="/admin/news" class="admin-menu-link">
                <i class="bi bi-newspaper"></i>
                <span>News & Events</span>
            </a>

            <a href="/admin/services" class="admin-menu-link">
                <i class="bi bi-person-workspace"></i>
                <span>Services</span>
            </a>

            <a href="/admin/wards" class="admin-menu-link">
                <i class="bi bi-geo-alt-fill"></i>
                <span>Wards</span>
            </a>

            <a href="/admin/downloads" class="admin-menu-link">
                <i class="bi bi-download"></i>
                <span>Downloads</span>
            </a>

            <a href="/admin/gallery" class="admin-menu-link">
                <i class="bi bi-images"></i>
                <span>Gallery</span>
            </a>

            <a href="/admin/slider" class="admin-menu-link active">
                <i class="bi bi-sliders"></i>
                <span>Homepage Slider</span>
            </a>


            <div class="admin-menu-title">
                SETTINGS
            </div>


            <a href="/admin/profile" class="admin-menu-link">
                <i class="bi bi-person-circle"></i>
                <span>Profile</span>
            </a>

            <a href="/admin/settings" class="admin-menu-link">
                <i class="bi bi-gear-fill"></i>
                <span>Settings</span>
            </a>

            <a
                href="/"
                target="_blank"
                class="admin-menu-link"
            >
                <i class="bi bi-globe"></i>
                <span>View Website</span>
            </a>

        </nav>


        <div class="admin-sidebar-bottom">

            <a href="/admin/login">

                <i class="bi bi-box-arrow-left"></i>

                <span>
                    Logout
                </span>

            </a>

        </div>

    </aside>


    <!-- =====================================================
         MAIN
    ====================================================== -->

    <main class="admin-main">


        <!-- TOPBAR -->

        <div class="admin-topbar">

            <div class="d-flex align-items-center gap-3">

                <button
                    type="button"
                    class="admin-mobile-menu"
                    onclick="toggleAdminSidebar()"
                >
                    <i class="bi bi-list"></i>
                </button>

                <div>

                    <h4>

                        <%= mode === "edit"
                            ? "Edit Slider"
                            : "Add Slider"
                        %>

                    </h4>

                    <p>

                        <%= mode === "edit"
                            ? "Update homepage slider information"
                            : "Add a new homepage slider"
                        %>

                    </p>

                </div>

            </div>


            <div class="admin-user">

                <div class="admin-user-icon">
                    <i class="bi bi-person-fill"></i>
                </div>

                <div class="d-none d-sm-block">

                    <strong>
                        Administrator
                    </strong>

                    <small>
                        Super Admin
                    </small>

                </div>

            </div>

        </div>


        <!-- =================================================
             CONTENT
        ================================================== -->

        <div class="admin-content">


            <!-- BREADCRUMB -->

            <div class="admin-breadcrumb mb-4">

                <a href="/admin/dashboard">
                    Dashboard
                </a>

                <i class="bi bi-chevron-right"></i>

                <a href="/admin/slider">
                    Homepage Slider
                </a>

                <i class="bi bi-chevron-right"></i>

                <span>

                    <%= mode === "edit"
                        ? "Edit"
                        : "Add"
                    %>

                </span>

            </div>


            <!-- TITLE -->

            <div class="admin-form-title">

                <h5>

                    <%= mode === "edit"
                        ? "Edit Homepage Slider"
                        : "Add New Homepage Slider"
                    %>

                </h5>

                <p>
                    Add an important image and configure how it appears on the homepage.
                </p>

            </div>


            <form
                action="#"
                method="POST"
                enctype="multipart/form-data"
                onsubmit="saveSlider(event)"
            >


                <div class="row g-4">


                    <!-- =================================================
                         LEFT
                    ================================================== -->

                    <div class="col-lg-8">


                        <!-- BASIC INFORMATION -->

                        <div class="admin-section-card mb-4">

                            <div class="admin-section-header">

                                <div>

                                    <h5>
                                        Slider Information
                                    </h5>

                                    <p>
                                        Enter the text and ordering information.
                                    </p>

                                </div>

                            </div>


                            <!-- TITLE -->

                            <div class="mb-4">

                                <label class="form-label">

                                    Slider Title

                                    <span class="text-danger">
                                        *
                                    </span>

                                </label>


                                <input
                                    type="text"
                                    id="sliderTitle"
                                    class="form-control"
                                    placeholder="e.g. Welcome to Bishnu Rural Municipality"
                                    value="<%= mode === 'edit' ? 'Welcome to Bishnu Rural Municipality' : '' %>"
                                    required
                                >

                            </div>


                            <!-- SUBTITLE -->

                            <div class="mb-4">

                                <label class="form-label">
                                    Subtitle
                                </label>


                                <textarea
                                    id="sliderSubtitle"
                                    class="form-control slider-subtitle-editor"
                                    placeholder="Write a short subtitle..."
                                ><%= mode === "edit" ? "Serving citizens with transparency, responsibility and better services." : "" %></textarea>

                            </div>


                            <div class="row g-3">


                                <!-- ORDER -->

                                <div class="col-md-6">

                                    <label class="form-label">

                                        Display Order

                                        <span class="text-danger">
                                            *
                                        </span>

                                    </label>


                                    <input
                                        type="number"
                                        id="sliderOrder"
                                        class="form-control"
                                        min="1"
                                        value="<%= mode === 'edit' ? '1' : '1' %>"
                                        required
                                    >


                                    <div class="form-text">
                                        Lower number appears first.
                                    </div>

                                </div>


                                <!-- STATUS -->

                                <div class="col-md-6">

                                    <label class="form-label">
                                        Status
                                    </label>


                                    <select
                                        id="sliderStatus"
                                        class="form-select"
                                        onchange="updateSliderStatus()"
                                    >

                                        <option value="active" selected>
                                            Active
                                        </option>

                                        <option value="inactive">
                                            Inactive
                                        </option>

                                    </select>

                                </div>

                            </div>

                        </div>


                        <!-- =================================================
                             IMAGE
                        ================================================== -->

                        <div class="admin-section-card mb-4">

                            <div class="admin-section-header">

                                <div>

                                    <h5>
                                        Slider Image
                                    </h5>

                                    <p>
                                        Upload the main homepage banner image.
                                    </p>

                                </div>

                            </div>


                            <div class="slider-upload-area">


                                <div
                                    id="sliderImagePlaceholder"
                                    class="slider-image-placeholder"
                                >

                                    <i class="bi bi-image"></i>

                                    <h6>
                                        Upload Slider Image
                                    </h6>

                                    <p>
                                        JPG, JPEG, PNG or WEBP
                                    </p>

                                    <small>
                                        Recommended ratio: 16:9
                                        &nbsp; | &nbsp;
                                        Maximum size: 5 MB
                                    </small>


                                    <label class="btn btn-primary mt-3">

                                        <i class="bi bi-folder2-open me-1"></i>

                                        Choose Image

                                        <input
                                            type="file"
                                            id="sliderImage"
                                            class="d-none"
                                            accept=".jpg,.jpeg,.png,.webp"
                                            onchange="previewSliderImage(event)"
                                        >

                                    </label>

                                </div>


                                <img
                                    id="sliderImagePreview"
                                    class="slider-image-preview d-none"
                                    src=""
                                    alt="Slider preview"
                                >

                            </div>


                            <% if (mode === "edit") { %>

                                <div class="existing-slider-file mt-3">

                                    <i class="bi bi-image"></i>

                                    <div>

                                        <small>
                                            Current Image
                                        </small>

                                        <strong>
                                            slide-1.jpg
                                        </strong>

                                    </div>

                                    <span class="badge bg-success-subtle text-success">
                                        Uploaded
                                    </span>

                                </div>

                            <% } %>

                        </div>


                        <!-- =================================================
                             BUTTON LINK
                        ================================================== -->

                        <div class="admin-section-card">

                            <div class="admin-section-header">

                                <div>

                                    <h5>
                                        Optional Button
                                    </h5>

                                    <p>
                                        Add a call-to-action button to the slide.
                                    </p>

                                </div>

                            </div>


                            <div class="row g-3">


                                <div class="col-md-6">

                                    <label class="form-label">
                                        Button Text
                                    </label>

                                    <input
                                        type="text"
                                        id="sliderButtonText"
                                        class="form-control"
                                        placeholder="e.g. Learn More"
                                        value="<%= mode === 'edit' ? 'Learn More' : '' %>"
                                    >

                                </div>


                                <div class="col-md-6">

                                    <label class="form-label">
                                        Button URL
                                    </label>

                                    <input
                                        type="text"
                                        id="sliderButtonUrl"
                                        class="form-control"
                                        placeholder="/about"
                                        value="<%= mode === 'edit' ? '/about' : '' %>"
                                    >

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- =================================================
                         RIGHT
                    ================================================== -->

                    <div class="col-lg-4">


                        <!-- PREVIEW -->

                        <div class="admin-section-card mb-4">

                            <div class="admin-section-header">

                                <div>

                                    <h5>
                                        Live Preview
                                    </h5>

                                    <p>
                                        Approximate homepage appearance.
                                    </p>

                                </div>

                            </div>


                            <div class="slider-form-preview">


                                <div class="slider-form-preview-media">

                                    <img
                                        id="sliderPreviewImage"
                                        src="<%= mode === 'edit' ? '/images/slide-1.jpg' : '' %>"
                                        alt="Slider preview"
                                        class="<%= mode === 'edit' ? '' : 'd-none' %>"
                                    >


                                    <div
                                        id="sliderPreviewPlaceholder"
                                        class="<%= mode === 'edit' ? 'd-none' : '' %>"
                                    >

                                        <i class="bi bi-image"></i>

                                    </div>


                                    <div class="slider-form-preview-overlay"></div>


                                    <div class="slider-form-preview-content">

                                        <span class="badge bg-primary mb-2">
                                            Bishnu Palika
                                        </span>


                                        <h5 id="previewSliderTitle">

                                            <%= mode === "edit"
                                                ? "Welcome to Bishnu Rural Municipality"
                                                : "Slider Title"
                                            %>

                                        </h5>


                                        <p id="previewSliderSubtitle">

                                            <%= mode === "edit"
                                                ? "Serving citizens with transparency, responsibility and better services."
                                                : "Slider subtitle will appear here."
                                            %>

                                        </p>


                                        <span
                                            id="previewSliderButton"
                                            class="btn btn-sm btn-light"
                                        >
                                            Learn More
                                        </span>

                                    </div>

                                </div>


                                <div class="slider-preview-meta">

                                    <div>

                                        <span>
                                            Order
                                        </span>

                                        <strong id="previewSliderOrder">
                                            1
                                        </strong>

                                    </div>


                                    <div>

                                        <span>
                                            Status
                                        </span>

                                        <strong
                                            id="previewSliderStatus"
                                            class="text-success"
                                        >
                                            Active
                                        </strong>

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- GUIDE -->

                        <div class="admin-section-card">


                            <div class="admin-section-header">

                                <div>

                                    <h5>
                                        Slider Guide
                                    </h5>

                                    <p>
                                        Recommended settings.
                                    </p>

                                </div>

                            </div>


                            <div class="admin-guide-item">

                                <i class="bi bi-aspect-ratio"></i>

                                <div>

                                    <strong>
                                        Use wide images
                                    </strong>

                                    <p>
                                        A 16:9 or similar wide image works
                                        best for the homepage slider.
                                    </p>

                                </div>

                            </div>


                            <div class="admin-guide-item">

                                <i class="bi bi-card-heading"></i>

                                <div>

                                    <strong>
                                        Keep text short
                                    </strong>

                                    <p>
                                        Use a clear title and short subtitle
                                        that is easy to read over the image.
                                    </p>

                                </div>

                            </div>


                            <div class="admin-guide-item">

                                <i class="bi bi-sort-numeric-down"></i>

                                <div>

                                    <strong>
                                        Set display order
                                    </strong>

                                    <p>
                                        Slides with smaller order numbers
                                        appear first.
                                    </p>

                                </div>

                            </div>


                            <div class="admin-guide-item">

                                <i class="bi bi-check-circle"></i>

                                <div>

                                    <strong>
                                        Activate only useful slides
                                    </strong>

                                    <p>
                                        Keep the homepage focused by
                                        activating important banners only.
                                    </p>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- BUTTONS -->

                <div class="d-flex flex-wrap justify-content-between gap-3 mt-4">


                    <a
                        href="/admin/slider"
                        class="btn btn-outline-secondary"
                    >

                        <i class="bi bi-arrow-left me-1"></i>

                        Cancel

                    </a>


                    <button
                        type="submit"
                        class="btn btn-primary"
                    >

                        <i class="bi bi-check-lg me-1"></i>

                        <%= mode === "edit"
                            ? "Update Slider"
                            : "Save Slider"
                        %>

                    </button>

                </div>

            </form>

        </div>

    </main>

</div>


<script>

/* =========================================================
   SIDEBAR
========================================================= */

function toggleAdminSidebar() {

    document
        .querySelector(".admin-sidebar")
        .classList.toggle("show");

}


/* =========================================================
   IMAGE PREVIEW
========================================================= */

function previewSliderImage(event) {

    const file =
        event.target.files[0];

    if (!file) {
        return;
    }


    const preview =
        document.getElementById("sliderImagePreview");

    const placeholder =
        document.getElementById("sliderImagePlaceholder");

    const rightPreview =
        document.getElementById("sliderPreviewImage");

    const rightPlaceholder =
        document.getElementById("sliderPreviewPlaceholder");


    const imageUrl =
        URL.createObjectURL(file);


    preview.src = imageUrl;

    preview.classList.remove("d-none");

    placeholder.classList.add("d-none");


    rightPreview.src = imageUrl;

    rightPreview.classList.remove("d-none");

    rightPlaceholder.classList.add("d-none");

}


/* =========================================================
   TITLE PREVIEW
========================================================= */

document
    .getElementById("sliderTitle")
    .addEventListener("input", function () {

        document
            .getElementById("previewSliderTitle")
            .textContent =
            this.value.trim() ||
            "Slider Title";

    });


/* =========================================================
   SUBTITLE PREVIEW
========================================================= */

document
    .getElementById("sliderSubtitle")
    .addEventListener("input", function () {

        document
            .getElementById("previewSliderSubtitle")
            .textContent =
            this.value.trim() ||
            "Slider subtitle will appear here.";

    });


/* =========================================================
   ORDER PREVIEW
========================================================= */

document
    .getElementById("sliderOrder")
    .addEventListener("input", function () {

        document
            .getElementById("previewSliderOrder")
            .textContent =
            this.value || "1";

    });


/* =========================================================
   STATUS PREVIEW
========================================================= */

function updateSliderStatus() {

    const status =
        document.getElementById("sliderStatus").value;

    const preview =
        document.getElementById("previewSliderStatus");


    if (status === "active") {

        preview.textContent =
            "Active";

        preview.className =
            "text-success";

    }

    else {

        preview.textContent =
            "Inactive";

        preview.className =
            "text-secondary";

    }

}


/* =========================================================
   BUTTON PREVIEW
========================================================= */

function updateSliderButton() {

    const text =
        document
            .getElementById("sliderButtonText")
            .value
            .trim();

    const button =
        document.getElementById("previewSliderButton");


    if (text) {

        button.textContent =
            text;

        button.classList.remove("d-none");

    }

    else {

        button.classList.add("d-none");

    }

}


document
    .getElementById("sliderButtonText")
    .addEventListener(
        "input",
        updateSliderButton
    );


/* =========================================================
   SAVE
========================================================= */

function saveSlider(event) {

    event.preventDefault();


    const title =
        document
            .getElementById("sliderTitle")
            .value
            .trim();


    if (!title) {

        alert(
            "Please enter the slider title."
        );

        return;

    }


    alert(
        "<%= mode === 'edit'
            ? 'Frontend demo: slider would be updated successfully.'
            : 'Frontend demo: slider would be saved successfully.'
        %>"
    );


    window.location.href =
        "/admin/slider";

}

</script>


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>