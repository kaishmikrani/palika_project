<script>

function toggleAdminSidebar() {

    document
        .querySelector(".admin-sidebar")
        .classList.toggle("show");

}


const searchInput =
    document.getElementById("adminEmployeeSearch");

const categorySelect =
    document.getElementById("adminEmployeeCategory");

const statusSelect =
    document.getElementById("adminEmployeeStatus");

const rows =
    document.querySelectorAll(".admin-employee-row");


function filterEmployees() {

    const search =
        searchInput.value.toLowerCase().trim();

    const category =
        categorySelect.value;

    const status =
        statusSelect.value;

    let visible = 0;


    rows.forEach(function(row) {

        const name =
            row.dataset.name.toLowerCase();

        const rowCategory =
            row.dataset.category;

        const rowStatus =
            row.dataset.status;


        const searchMatch =
            name.includes(search);

        const categoryMatch =
            !category ||
            rowCategory === category;

        const statusMatch =
            !status ||
            rowStatus === status;


        if (
            searchMatch &&
            categoryMatch &&
            statusMatch
        ) {

            row.style.display = "";

            visible++;

        } else {

            row.style.display = "none";

        }

    });


    document.getElementById(
        "employeeResultText"
    ).textContent =
        `Showing ${visible} matching employee${visible === 1 ? "" : "s"}`;

}


searchInput.addEventListener(
    "input",
    filterEmployees
);

categorySelect.addEventListener(
    "change",
    filterEmployees
);

statusSelect.addEventListener(
    "change",
    filterEmployees
);


function resetEmployeeFilters() {

    searchInput.value = "";

    categorySelect.value = "";

    statusSelect.value = "";

    filterEmployees();

}


function deleteEmployee(button, name) {

    const confirmed =
        confirm(
            `Are you sure you want to delete ${name}?`
        );

    if (!confirmed) {
        return;
    }

    button
        .closest("tr")
        .remove();

    alert(
        "Employee deleted from the demo interface."
    );

}

</script>


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

