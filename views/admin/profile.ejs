<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= title || "Admin Profile" %></title>

    <!-- Bootstrap -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <!-- Bootstrap Icons -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
        rel="stylesheet"
    >

    <!-- Main CSS -->
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="admin-page">

    <!-- =========================
         SIDEBAR
    ========================== -->
    <aside class="admin-sidebar">

        <div class="admin-brand">
            <div class="admin-brand-icon">
                <i class="bi bi-building"></i>
            </div>

            <div>
                <h5>Bishnu Palika</h5>
                <small>Admin Panel</small>
            </div>
        </div>

        <div class="admin-menu-title">
            MAIN MENU
        </div>

        <nav class="admin-menu">

            <a href="/admin/dashboard" class="admin-menu-link">
                <i class="bi bi-grid-1x2-fill"></i>
                <span>Dashboard</span>
            </a>

            <a href="/admin/notices" class="admin-menu-link">
                <i class="bi bi-megaphone-fill"></i>
                <span>Notices</span>
            </a>

            <a href="/admin/news" class="admin-menu-link">
                <i class="bi bi-newspaper"></i>
                <span>News & Events</span>
            </a>

            <a href="/admin/services" class="admin-menu-link">
                <i class="bi bi-person-workspace"></i>
                <span>Services</span>
            </a>

            <a href="/admin/wards" class="admin-menu-link">
                <i class="bi bi-geo-alt-fill"></i>
                <span>Wards</span>
            </a>

            <a href="/admin/downloads" class="admin-menu-link">
                <i class="bi bi-download"></i>
                <span>Downloads</span>
            </a>

            <a href="/admin/gallery" class="admin-menu-link">
                <i class="bi bi-images"></i>
                <span>Gallery</span>
            </a>

            <a href="/admin/slider" class="admin-menu-link">
                <i class="bi bi-sliders"></i>
                <span>Homepage Slider</span>
            </a>

            <div class="admin-menu-title">
                SETTINGS
            </div>

            <a href="/admin/profile" class="admin-menu-link active">
                <i class="bi bi-person-circle"></i>
                <span>Profile</span>
            </a>

            <a href="/admin/settings" class="admin-menu-link">
                <i class="bi bi-gear-fill"></i>
                <span>Settings</span>
            </a>

            <a href="/" target="_blank" class="admin-menu-link">
                <i class="bi bi-globe"></i>
                <span>View Website</span>
            </a>

        </nav>

        <div class="admin-sidebar-bottom">
            <a href="/admin/login">
                <i class="bi bi-box-arrow-left"></i>
                <span>Logout</span>
            </a>
        </div>

    </aside>


    <!-- =========================
         MAIN AREA
    ========================== -->
    <main class="admin-main">

        <!-- TOPBAR -->
        <div class="admin-topbar">

            <div class="d-flex align-items-center gap-3">

                <button
                    type="button"
                    class="admin-mobile-menu"
                    onclick="toggleAdminSidebar()"
                >
                    <i class="bi bi-list"></i>
                </button>

                <div>
                    <h4>Admin Profile</h4>
                    <p>Manage your administrator account information</p>
                </div>

            </div>


            <!-- ADMIN USER -->
            <div class="admin-user d-none d-sm-flex">

                <div class="admin-user-icon">
                    <i class="bi bi-person-fill"></i>
                </div>

                <div>
                    <strong>Administrator</strong>
                    <small>Super Admin</small>
                </div>

            </div>

        </div>


        <!-- CONTENT -->
        <div class="admin-content">

            <!-- BREADCRUMB -->
            <div class="admin-breadcrumb mb-4">

                <a href="/admin/dashboard">
                    Dashboard
                </a>

                <i class="bi bi-chevron-right"></i>

                <span>Profile</span>

            </div>


            <!-- PROFILE HEADER -->
            <div class="profile-header-card mb-4">

                <div class="profile-header-main">

                    <div class="profile-avatar-wrapper">

                        <div
                            class="profile-avatar"
                            id="profileAvatar"
                        >
                            <span id="profileInitials">
                                AD
                            </span>

                            <img
                                src=""
                                alt="Profile"
                                id="profileAvatarImage"
                                class="d-none"
                            >
                        </div>

                        <label
                            for="profileImage"
                            class="profile-avatar-edit"
                            title="Change Profile Photo"
                        >
                            <i class="bi bi-camera-fill"></i>
                        </label>

                    </div>


                    <div class="profile-header-info">

                        <h3>Administrator</h3>

                        <p class="mb-2">
                            <i class="bi bi-shield-check me-1"></i>
                            Super Administrator
                        </p>

                        <span class="profile-active-badge">
                            <span></span>
                            Active Account
                        </span>

                    </div>

                </div>


                <div class="profile-header-meta">

                    <div>
                        <small>Username</small>
                        <strong>admin</strong>
                    </div>

                    <div>
                        <small>Member Since</small>
                        <strong>January 2026</strong>
                    </div>

                </div>

            </div>


            <!-- HIDDEN IMAGE INPUT -->
            <input
                type="file"
                id="profileImage"
                accept="image/png,image/jpeg,image/webp"
                class="d-none"
            >


            <div class="row g-4">

                <!-- =========================
                     PERSONAL INFORMATION
                ========================== -->
                <div class="col-lg-8">

                    <div class="admin-section-card h-100">

                        <div class="admin-section-header">

                            <div>
                                <h5>Personal Information</h5>

                                <p>
                                    Update your basic administrator information.
                                </p>
                            </div>

                            <i class="bi bi-person-vcard text-primary fs-4"></i>

                        </div>


                        <form id="profileForm">

                            <div class="row g-3">

                                <!-- FULL NAME -->
                                <div class="col-md-6">

                                    <label class="form-label">
                                        Full Name
                                    </label>

                                    <input
                                        type="text"
                                        class="form-control"
                                        id="fullName"
                                        value="Administrator"
                                        placeholder="Enter full name"
                                    >

                                </div>


                                <!-- USERNAME -->
                                <div class="col-md-6">

                                    <label class="form-label">
                                        Username
                                    </label>

                                    <input
                                        type="text"
                                        class="form-control"
                                        value="admin"
                                        placeholder="Enter username"
                                    >

                                </div>


                                <!-- EMAIL -->
                                <div class="col-md-6">

                                    <label class="form-label">
                                        Email Address
                                    </label>

                                    <input
                                        type="email"
                                        class="form-control"
                                        value="admin@bishnupalika.gov.np"
                                        placeholder="Enter email address"
                                    >

                                </div>


                                <!-- PHONE -->
                                <div class="col-md-6">

                                    <label class="form-label">
                                        Phone Number
                                    </label>

                                    <input
                                        type="tel"
                                        class="form-control"
                                        value="+977-98XXXXXXXX"
                                        placeholder="Enter phone number"
                                    >

                                </div>


                                <!-- ROLE -->
                                <div class="col-md-6">

                                    <label class="form-label">
                                        Role
                                    </label>

                                    <input
                                        type="text"
                                        class="form-control"
                                        value="Super Administrator"
                                        readonly
                                    >

                                    <div class="form-text">
                                        Administrator role can be changed from
                                        the backend later.
                                    </div>

                                </div>


                                <!-- STATUS -->
                                <div class="col-md-6">

                                    <label class="form-label">
                                        Account Status
                                    </label>

                                    <div class="profile-status-field">

                                        <span class="profile-status-dot"></span>

                                        <div>
                                            <strong>Active</strong>
                                            <small>
                                                Account is currently active
                                            </small>
                                        </div>

                                    </div>

                                </div>


                                <!-- BIO -->
                                <div class="col-12">

                                    <label class="form-label">
                                        Short Bio
                                    </label>

                                    <textarea
                                        class="form-control profile-bio"
                                        rows="4"
                                        placeholder="Write a short description..."
                                    >Administrator of Bishnu Rural Municipality website.</textarea>

                                </div>

                            </div>


                            <div class="profile-form-footer mt-4">

                                <small>
                                    <i class="bi bi-info-circle me-1"></i>
                                    Changes are currently for UI preview only.
                                </small>

                                <button
                                    type="submit"
                                    class="btn btn-primary"
                                >
                                    <i class="bi bi-check2-circle me-1"></i>
                                    Save Changes
                                </button>

                            </div>

                        </form>

                    </div>

                </div>


                <!-- =========================
                     ACCOUNT INFORMATION
                ========================== -->
                <div class="col-lg-4">

                    <div class="admin-section-card h-100">

                        <div class="admin-section-header">

                            <div>
                                <h5>Account Information</h5>

                                <p>
                                    Your account activity details.
                                </p>
                            </div>

                            <i class="bi bi-person-badge text-primary fs-4"></i>

                        </div>


                        <div class="account-info-list">

                            <div class="account-info-item">

                                <div class="account-info-icon">
                                    <i class="bi bi-person"></i>
                                </div>

                                <div>
                                    <small>Username</small>
                                    <strong>admin</strong>
                                </div>

                            </div>


                            <div class="account-info-item">

                                <div class="account-info-icon">
                                    <i class="bi bi-shield-check"></i>
                                </div>

                                <div>
                                    <small>Role</small>
                                    <strong>Super Admin</strong>
                                </div>

                            </div>


                            <div class="account-info-item">

                                <div class="account-info-icon">
                                    <i class="bi bi-clock-history"></i>
                                </div>

                                <div>
                                    <small>Last Login</small>
                                    <strong>Today, 09:42 AM</strong>
                                </div>

                            </div>


                            <div class="account-info-item">

                                <div class="account-info-icon">
                                    <i class="bi bi-calendar-check"></i>
                                </div>

                                <div>
                                    <small>Account Created</small>
                                    <strong>15 January 2026</strong>
                                </div>

                            </div>


                            <div class="account-info-item">

                                <div class="account-info-icon">
                                    <i class="bi bi-check-circle"></i>
                                </div>

                                <div>
                                    <small>Status</small>

                                    <strong class="text-success">
                                        Active
                                    </strong>

                                </div>

                            </div>

                        </div>


                        <div class="account-security-note">

                            <i class="bi bi-shield-lock-fill"></i>

                            <div>
                                <strong>Account Security</strong>

                                <p>
                                    Keep your account credentials private
                                    and use a strong password.
                                </p>
                            </div>

                        </div>

                    </div>

                </div>


                <!-- =========================
                     CHANGE PASSWORD
                ========================== -->
                <div class="col-lg-8">

                    <div class="admin-section-card">

                        <div class="admin-section-header">

                            <div>
                                <h5>Password & Security</h5>

                                <p>
                                    Change your administrator account password.
                                </p>
                            </div>

                            <i class="bi bi-shield-lock text-primary fs-4"></i>

                        </div>


                        <form id="passwordForm">

                            <div class="row g-3">

                                <!-- CURRENT PASSWORD -->
                                <div class="col-12">

                                    <label class="form-label">
                                        Current Password
                                    </label>

                                    <div class="password-input-wrapper">

                                        <input
                                            type="password"
                                            class="form-control"
                                            id="currentPassword"
                                            placeholder="Enter current password"
                                        >

                                        <button
                                            type="button"
                                            class="password-toggle-btn"
                                            onclick="toggleProfilePassword('currentPassword', 'currentPasswordIcon')"
                                        >
                                            <i
                                                class="bi bi-eye"
                                                id="currentPasswordIcon"
                                            ></i>
                                        </button>

                                    </div>

                                </div>


                                <!-- NEW PASSWORD -->
                                <div class="col-md-6">

                                    <label class="form-label">
                                        New Password
                                    </label>

                                    <div class="password-input-wrapper">

                                        <input
                                            type="password"
                                            class="form-control"
                                            id="newPassword"
                                            placeholder="Enter new password"
                                        >

                                        <button
                                            type="button"
                                            class="password-toggle-btn"
                                            onclick="toggleProfilePassword('newPassword', 'newPasswordIcon')"
                                        >
                                            <i
                                                class="bi bi-eye"
                                                id="newPasswordIcon"
                                            ></i>
                                        </button>

                                    </div>

                                </div>


                                <!-- CONFIRM PASSWORD -->
                                <div class="col-md-6">

                                    <label class="form-label">
                                        Confirm New Password
                                    </label>

                                    <div class="password-input-wrapper">

                                        <input
                                            type="password"
                                            class="form-control"
                                            id="confirmPassword"
                                            placeholder="Confirm new password"
                                        >

                                        <button
                                            type="button"
                                            class="password-toggle-btn"
                                            onclick="toggleProfilePassword('confirmPassword', 'confirmPasswordIcon')"
                                        >
                                            <i
                                                class="bi bi-eye"
                                                id="confirmPasswordIcon"
                                            ></i>
                                        </button>

                                    </div>

                                </div>

                            </div>


                            <div class="password-requirements mt-4">

                                <h6>
                                    <i class="bi bi-info-circle me-1"></i>
                                    Password Requirements
                                </h6>

                                <div class="row g-2">

                                    <div class="col-md-6">
                                        <div class="password-rule">
                                            <i class="bi bi-check2"></i>
                                            At least 8 characters
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="password-rule">
                                            <i class="bi bi-check2"></i>
                                            One uppercase letter
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="password-rule">
                                            <i class="bi bi-check2"></i>
                                            One lowercase letter
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="password-rule">
                                            <i class="bi bi-check2"></i>
                                            One number or special character
                                        </div>
                                    </div>

                                </div>

                            </div>


                            <div class="profile-form-footer mt-4">

                                <small>
                                    <i class="bi bi-lock me-1"></i>
                                    Password security will be handled by the
                                    backend later.
                                </small>

                                <button
                                    type="submit"
                                    class="btn btn-outline-primary"
                                >
                                    <i class="bi bi-key me-1"></i>
                                    Change Password
                                </button>

                            </div>

                        </form>

                    </div>

                </div>


                <!-- =========================
                     PROFILE PHOTO
                ========================== -->
                <div class="col-lg-4">

                    <div class="admin-section-card h-100">

                        <div class="admin-section-header">

                            <div>
                                <h5>Profile Photo</h5>

                                <p>
                                    Upload your administrator photo.
                                </p>
                            </div>

                            <i class="bi bi-camera text-primary fs-4"></i>

                        </div>


                        <div class="profile-photo-box">

                            <div class="profile-photo-large">

                                <span id="largeProfileInitials">
                                    AD
                                </span>

                                <img
                                    src=""
                                    alt="Profile"
                                    id="largeProfileImage"
                                    class="d-none"
                                >

                            </div>


                            <h6>
                                Administrator
                            </h6>

                            <p>
                                JPG, PNG or WEBP
                                <br>
                                Recommended size: 400 × 400px
                            </p>


                            <label
                                for="profileImage"
                                class="btn btn-outline-primary btn-sm"
                            >
                                <i class="bi bi-upload me-1"></i>
                                Choose Photo
                            </label>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </main>


    <!-- =========================
         BOOTSTRAP JS
    ========================== -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>


    <!-- =========================
         PAGE JS
    ========================== -->
    <script>

        // Mobile sidebar
        function toggleAdminSidebar() {
            document
                .querySelector(".admin-sidebar")
                .classList.toggle("show");
        }


        // Password visibility
        function toggleProfilePassword(inputId, iconId) {

            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);

            if (input.type === "password") {

                input.type = "text";

                icon.classList.remove("bi-eye");
                icon.classList.add("bi-eye-slash");

            } else {

                input.type = "password";

                icon.classList.remove("bi-eye-slash");
                icon.classList.add("bi-eye");

            }

        }


        // Profile image preview
        document
            .getElementById("profileImage")
            .addEventListener("change", function(event) {

                const file = event.target.files[0];

                if (!file) return;

                const imageUrl = URL.createObjectURL(file);

                const avatarImage =
                    document.getElementById("profileAvatarImage");

                const largeImage =
                    document.getElementById("largeProfileImage");

                const initials =
                    document.getElementById("profileInitials");

                const largeInitials =
                    document.getElementById("largeProfileInitials");


                avatarImage.src = imageUrl;
                avatarImage.classList.remove("d-none");

                largeImage.src = imageUrl;
                largeImage.classList.remove("d-none");

                initials.classList.add("d-none");
                largeInitials.classList.add("d-none");

            });


        // Profile form
        document
            .getElementById("profileForm")
            .addEventListener("submit", function(event) {

                event.preventDefault();

                alert(
                    "Profile changes saved successfully! " +
                    "(Frontend demo only)"
                );

            });


        // Password form
        document
            .getElementById("passwordForm")
            .addEventListener("submit", function(event) {

                event.preventDefault();

                const newPassword =
                    document.getElementById("newPassword").value;

                const confirmPassword =
                    document.getElementById("confirmPassword").value;


                if (newPassword !== confirmPassword) {

                    alert("New password and confirm password do not match.");

                    return;

                }


                if (newPassword.length < 8) {

                    alert("Password must contain at least 8 characters.");

                    return;

                }


                alert(
                    "Password changed successfully! " +
                    "(Frontend demo only)"
                );

            });


        // Update profile name in header while typing
        document
            .getElementById("fullName")
            .addEventListener("input", function() {

                const name =
                    this.value.trim() || "Administrator";

                document.querySelector(
                    ".profile-header-info h3"
                ).textContent = name;

            });

    </script>

</body>
</html>