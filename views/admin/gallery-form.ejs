<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= title || "Add Gallery Item" %></title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
        rel="stylesheet"
    >

    <link rel="stylesheet" href="/css/style.css">

</head>

<body>

<div class="admin-page">


    <!-- =====================================================
         SIDEBAR
    ====================================================== -->

    <aside class="admin-sidebar">

        <div class="admin-brand">

            <div class="admin-brand-icon">
                <i class="bi bi-building"></i>
            </div>

            <div>
                <h5>Bishnu Palika</h5>
                <small>Admin Panel</small>
            </div>

        </div>


        <div class="admin-menu-title">
            MAIN MENU
        </div>


        <nav class="admin-menu">

            <a href="/admin/dashboard" class="admin-menu-link">
                <i class="bi bi-grid-1x2-fill"></i>
                <span>Dashboard</span>
            </a>

            <a href="/admin/notices" class="admin-menu-link">
                <i class="bi bi-megaphone-fill"></i>
                <span>Notices</span>
            </a>

            <a href="/admin/news" class="admin-menu-link">
                <i class="bi bi-newspaper"></i>
                <span>News & Events</span>
            </a>

            <a href="/admin/services" class="admin-menu-link">
                <i class="bi bi-person-workspace"></i>
                <span>Services</span>
            </a>

            <a href="/admin/wards" class="admin-menu-link">
                <i class="bi bi-geo-alt-fill"></i>
                <span>Wards</span>
            </a>

            <a href="/admin/downloads" class="admin-menu-link">
                <i class="bi bi-download"></i>
                <span>Downloads</span>
            </a>

            <a href="/admin/gallery" class="admin-menu-link active">
                <i class="bi bi-images"></i>
                <span>Gallery</span>
            </a>

            <a href="/admin/slider" class="admin-menu-link">
                <i class="bi bi-sliders"></i>
                <span>Homepage Slider</span>
            </a>


            <div class="admin-menu-title">
                SETTINGS
            </div>


            <a href="/admin/profile" class="admin-menu-link">
                <i class="bi bi-person-circle"></i>
                <span>Profile</span>
            </a>

            <a href="/admin/settings" class="admin-menu-link">
                <i class="bi bi-gear-fill"></i>
                <span>Settings</span>
            </a>

            <a
                href="/"
                target="_blank"
                class="admin-menu-link"
            >
                <i class="bi bi-globe"></i>
                <span>View Website</span>
            </a>

        </nav>


        <div class="admin-sidebar-bottom">

            <a href="/admin/login">

                <i class="bi bi-box-arrow-left"></i>

                <span>
                    Logout
                </span>

            </a>

        </div>

    </aside>


    <!-- =====================================================
         MAIN
    ====================================================== -->

    <main class="admin-main">


        <!-- TOPBAR -->

        <div class="admin-topbar">

            <div class="d-flex align-items-center gap-3">

                <button
                    type="button"
                    class="admin-mobile-menu"
                    onclick="toggleAdminSidebar()"
                >
                    <i class="bi bi-list"></i>
                </button>

                <div>

                    <h4>

                        <%= mode === "edit"
                            ? "Edit Gallery Item"
                            : "Add Gallery Item"
                        %>

                    </h4>

                    <p>

                        <%= mode === "edit"
                            ? "Update photo or video information"
                            : "Add a new photo or video"
                        %>

                    </p>

                </div>

            </div>


            <div class="admin-user">

                <div class="admin-user-icon">
                    <i class="bi bi-person-fill"></i>
                </div>

                <div class="d-none d-sm-block">

                    <strong>
                        Administrator
                    </strong>

                    <small>
                        Super Admin
                    </small>

                </div>

            </div>

        </div>


        <!-- =================================================
             CONTENT
        ================================================== -->

        <div class="admin-content">


            <!-- BREADCRUMB -->

            <div class="admin-breadcrumb mb-4">

                <a href="/admin/dashboard">
                    Dashboard
                </a>

                <i class="bi bi-chevron-right"></i>

                <a href="/admin/gallery">
                    Gallery
                </a>

                <i class="bi bi-chevron-right"></i>

                <span>

                    <%= mode === "edit"
                        ? "Edit"
                        : "Add"
                    %>

                </span>

            </div>


            <!-- TITLE -->

            <div class="admin-form-title">

                <h5>

                    <%= mode === "edit"
                        ? "Edit Gallery Item"
                        : "Add New Gallery Item"
                    %>

                </h5>

                <p>
                    Upload a photo or add a video for the municipality gallery.
                </p>

            </div>


            <form
                action="#"
                method="POST"
                enctype="multipart/form-data"
                onsubmit="saveGalleryItem(event)"
            >


                <div class="row g-4">


                    <!-- =================================================
                         LEFT
                    ================================================== -->

                    <div class="col-lg-8">


                        <!-- BASIC INFORMATION -->

                        <div class="admin-section-card mb-4">


                            <div class="admin-section-header">

                                <div>

                                    <h5>
                                        Basic Information
                                    </h5>

                                    <p>
                                        Enter information about this gallery item.
                                    </p>

                                </div>

                            </div>


                            <!-- TITLE -->

                            <div class="mb-4">

                                <label class="form-label">

                                    Title

                                    <span class="text-danger">
                                        *
                                    </span>

                                </label>


                                <input
                                    type="text"
                                    id="galleryTitle"
                                    class="form-control"
                                    placeholder="e.g. Municipality Office"
                                    value="<%= mode === 'edit' ? 'Bishnu Rural Municipality Office' : '' %>"
                                    required
                                >

                            </div>


                            <div class="row g-3">


                                <!-- TYPE -->

                                <div class="col-md-6">

                                    <label class="form-label">

                                        Media Type

                                        <span class="text-danger">
                                            *
                                        </span>

                                    </label>


                                    <select
                                        id="galleryType"
                                        class="form-select"
                                        onchange="toggleMediaFields()"
                                        required
                                    >

                                        <option value="photo"
                                            <%= mode !== "edit" ? "selected" : "" %>
                                        >
                                            Photo
                                        </option>

                                        <option value="video">
                                            Video
                                        </option>

                                    </select>

                                </div>


                                <!-- CATEGORY -->

                                <div class="col-md-6">

                                    <label class="form-label">

                                        Category

                                        <span class="text-danger">
                                            *
                                        </span>

                                    </label>


                                    <select
                                        id="galleryCategory"
                                        class="form-select"
                                        required
                                    >

                                        <option value="">
                                            Select Category
                                        </option>

                                        <option
                                            <%= mode === "edit" ? "selected" : "" %>
                                        >
                                            Municipality
                                        </option>

                                        <option>
                                            Events
                                        </option>

                                        <option>
                                            Infrastructure
                                        </option>

                                        <option>
                                            Development
                                        </option>

                                        <option>
                                            Officials
                                        </option>

                                        <option>
                                            Nature
                                        </option>

                                        <option>
                                            Programs
                                        </option>

                                        <option>
                                            Other
                                        </option>

                                    </select>

                                </div>


                            </div>


                            <!-- DESCRIPTION -->

                            <div class="mt-4">

                                <label class="form-label">
                                    Description
                                </label>


                                <textarea
                                    id="galleryDescription"
                                    class="form-control gallery-description-editor"
                                    placeholder="Write a short description..."
                                ><%= mode === "edit" ? "Photo of the Bishnu Rural Municipality Office." : "" %></textarea>

                            </div>

                        </div>


                        <!-- =================================================
                             PHOTO UPLOAD
                        ================================================== -->

                        <div
                            class="admin-section-card mb-4"
                            id="photoUploadSection"
                        >

                            <div class="admin-section-header">

                                <div>

                                    <h5>
                                        Photo
                                    </h5>

                                    <p>
                                        Upload the image for this gallery item.
                                    </p>

                                </div>

                            </div>


                            <div class="gallery-upload-area">


                                <div
                                    id="galleryImagePlaceholder"
                                    class="gallery-image-placeholder"
                                >

                                    <i class="bi bi-image"></i>

                                    <h6>
                                        Upload Gallery Image
                                    </h6>

                                    <p>
                                        JPG, JPEG, PNG or WEBP
                                    </p>

                                    <small>
                                        Recommended maximum size: 5 MB
                                    </small>

                                    <label class="btn btn-primary mt-3">

                                        <i class="bi bi-folder2-open me-1"></i>

                                        Choose Image

                                        <input
                                            type="file"
                                            id="galleryImage"
                                            class="d-none"
                                            accept=".jpg,.jpeg,.png,.webp"
                                            onchange="previewGalleryImage(event)"
                                        >

                                    </label>

                                </div>


                                <img
                                    id="galleryImagePreview"
                                    class="gallery-image-preview d-none"
                                    src=""
                                    alt="Preview"
                                >

                            </div>


                            <% if (mode === "edit") { %>

                                <div class="existing-gallery-file mt-3">

                                    <i class="bi bi-image"></i>

                                    <div>

                                        <small>
                                            Current Image
                                        </small>

                                        <strong>
                                            gallery-1.jpg
                                        </strong>

                                    </div>

                                    <span class="badge bg-success-subtle text-success">
                                        Uploaded
                                    </span>

                                </div>

                            <% } %>

                        </div>


                        <!-- =================================================
                             VIDEO
                        ================================================== -->

                        <div
                            class="admin-section-card mb-4 d-none"
                            id="videoSection"
                        >

                            <div class="admin-section-header">

                                <div>

                                    <h5>
                                        Video
                                    </h5>

                                    <p>
                                        Add a video file or external video URL.
                                    </p>

                                </div>

                            </div>


                            <label class="form-label">
                                Video URL
                            </label>


                            <div class="input-group mb-3">

                                <span class="input-group-text">
                                    <i class="bi bi-link-45deg"></i>
                                </span>

                                <input
                                    type="url"
                                    id="videoUrl"
                                    class="form-control"
                                    placeholder="https://www.youtube.com/watch?v=..."
                                >

                            </div>


                            <div class="text-center text-muted mb-3">
                                OR
                            </div>


                            <div class="gallery-video-upload-box">

                                <i class="bi bi-camera-video"></i>

                                <h6>
                                    Upload Video File
                                </h6>

                                <p>
                                    MP4, WEBM or MOV
                                </p>

                                <label class="btn btn-outline-primary">

                                    <i class="bi bi-folder2-open me-1"></i>

                                    Choose Video

                                    <input
                                        type="file"
                                        class="d-none"
                                        accept=".mp4,.webm,.mov"
                                        onchange="previewVideoFile(event)"
                                    >

                                </label>

                            </div>


                            <div
                                id="selectedVideoBox"
                                class="selected-gallery-file d-none mt-3"
                            >

                                <i class="bi bi-file-earmark-play"></i>

                                <div>

                                    <strong id="selectedVideoName">
                                        video.mp4
                                    </strong>

                                    <small id="selectedVideoSize">
                                        0 MB
                                    </small>

                                </div>

                            </div>

                        </div>


                        <!-- =================================================
                             PUBLISHING
                        ================================================== -->

                        <div class="admin-section-card">


                            <div class="admin-section-header">

                                <div>

                                    <h5>
                                        Publishing
                                    </h5>

                                    <p>
                                        Control how this gallery item is displayed.
                                    </p>

                                </div>

                            </div>


                            <div class="row g-3">


                                <div class="col-md-6">

                                    <label class="form-label">
                                        Status
                                    </label>


                                    <select
                                        id="galleryStatus"
                                        class="form-select"
                                        onchange="updateGalleryStatus()"
                                    >

                                        <option value="published"
                                            <%= mode !== "edit" ? "selected" : "" %>
                                        >
                                            Published
                                        </option>

                                        <option value="draft">
                                            Draft
                                        </option>

                                    </select>

                                </div>


                                <div class="col-md-6 d-flex align-items-end">

                                    <div class="form-check form-switch">

                                        <input
                                            class="form-check-input"
                                            type="checkbox"
                                            id="featuredGallery"
                                        >

                                        <label
                                            class="form-check-label"
                                            for="featuredGallery"
                                        >
                                            Featured Item
                                        </label>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- =================================================
                         RIGHT
                    ================================================== -->

                    <div class="col-lg-4">


                        <!-- PREVIEW -->

                        <div class="admin-section-card mb-4">


                            <div class="admin-section-header">

                                <div>

                                    <h5>
                                        Preview
                                    </h5>

                                    <p>
                                        Gallery item preview.
                                    </p>

                                </div>

                            </div>


                            <div class="gallery-preview-card">


                                <div
                                    class="gallery-preview-media"
                                    id="galleryPreviewMedia"
                                >

                                    <img
                                        id="galleryPreviewImage"
                                        src="/images/gallery-1.jpg"
                                        alt="Gallery preview"
                                    >

                                    <div
                                        id="galleryPreviewVideo"
                                        class="d-none gallery-preview-video"
                                    >

                                        <i class="bi bi-play-circle-fill"></i>

                                        <span>
                                            Video
                                        </span>

                                    </div>

                                </div>


                                <div class="mt-3">


                                    <span
                                        id="previewCategory"
                                        class="admin-category-badge"
                                    >
                                        Municipality
                                    </span>


                                    <h5 id="previewTitle">
                                        <%= mode === "edit"
                                            ? "Bishnu Rural Municipality Office"
                                            : "Gallery Title"
                                        %>
                                    </h5>


                                    <p id="previewDescription">
                                        Gallery description will appear here.
                                    </p>


                                    <div class="gallery-preview-status">

                                        <span
                                            id="previewStatus"
                                            class="badge bg-success-subtle text-success"
                                        >
                                            Published
                                        </span>

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- GUIDE -->

                        <div class="admin-section-card">


                            <div class="admin-section-header">

                                <div>

                                    <h5>
                                        Publishing Guide
                                    </h5>

                                    <p>
                                        Before publishing.
                                    </p>

                                </div>

                            </div>


                            <div class="admin-guide-item">

                                <i class="bi bi-image"></i>

                                <div>

                                    <strong>
                                        Use good quality images
                                    </strong>

                                    <p>
                                        Use clear images that represent
                                        the municipality properly.
                                    </p>

                                </div>

                            </div>


                            <div class="admin-guide-item">

                                <i class="bi bi-card-heading"></i>

                                <div>

                                    <strong>
                                        Add a clear title
                                    </strong>

                                    <p>
                                        Use a meaningful title so citizens
                                        understand the image or video.
                                    </p>

                                </div>

                            </div>


                            <div class="admin-guide-item">

                                <i class="bi bi-folder-check"></i>

                                <div>

                                    <strong>
                                        Select correct category
                                    </strong>

                                    <p>
                                        Categorization makes the public
                                        gallery easier to browse.
                                    </p>

                                </div>

                            </div>


                            <div class="admin-guide-item">

                                <i class="bi bi-shield-check"></i>

                                <div>

                                    <strong>
                                        Verify before publishing
                                    </strong>

                                    <p>
                                        Check that the media does not contain
                                        inappropriate or confidential content.
                                    </p>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- BUTTONS -->

                <div class="d-flex flex-wrap justify-content-between gap-3 mt-4">


                    <a
                        href="/admin/gallery"
                        class="btn btn-outline-secondary"
                    >

                        <i class="bi bi-arrow-left me-1"></i>

                        Cancel

                    </a>


                    <button
                        type="submit"
                        class="btn btn-primary"
                    >

                        <i class="bi bi-check-lg me-1"></i>

                        <%= mode === "edit"
                            ? "Update Gallery Item"
                            : "Save Gallery Item"
                        %>

                    </button>

                </div>

            </form>

        </div>

    </main>

</div>


<script>

/* =========================================================
   SIDEBAR
========================================================= */

function toggleAdminSidebar() {

    document
        .querySelector(".admin-sidebar")
        .classList.toggle("show");

}


/* =========================================================
   MEDIA TYPE
========================================================= */

function toggleMediaFields() {

    const type =
        document.getElementById("galleryType").value;

    const photoSection =
        document.getElementById("photoUploadSection");

    const videoSection =
        document.getElementById("videoSection");

    const previewImage =
        document.getElementById("galleryPreviewImage");

    const previewVideo =
        document.getElementById("galleryPreviewVideo");


    if (type === "video") {

        photoSection.classList.add("d-none");

        videoSection.classList.remove("d-none");

        previewImage.classList.add("d-none");

        previewVideo.classList.remove("d-none");

    }

    else {

        photoSection.classList.remove("d-none");

        videoSection.classList.add("d-none");

        previewImage.classList.remove("d-none");

        previewVideo.classList.add("d-none");

    }

}


/* =========================================================
   IMAGE PREVIEW
========================================================= */

function previewGalleryImage(event) {

    const file =
        event.target.files[0];

    if (!file) {
        return;
    }


    const preview =
        document.getElementById("galleryImagePreview");

    const placeholder =
        document.getElementById("galleryImagePlaceholder");


    preview.src =
        URL.createObjectURL(file);

    preview.classList.remove("d-none");

    placeholder.classList.add("d-none");


    /* Update right-side preview */

    const galleryPreview =
        document.getElementById("galleryPreviewImage");

    galleryPreview.src =
        URL.createObjectURL(file);

}


/* =========================================================
   VIDEO FILE
========================================================= */

function previewVideoFile(event) {

    const file =
        event.target.files[0];

    if (!file) {
        return;
    }


    const box =
        document.getElementById("selectedVideoBox");

    const name =
        document.getElementById("selectedVideoName");

    const size =
        document.getElementById("selectedVideoSize");


    box.classList.remove("d-none");

    name.textContent =
        file.name;

    size.textContent =
        formatFileSize(file.size);

}


/* =========================================================
   FILE SIZE
========================================================= */

function formatFileSize(bytes) {

    if (bytes === 0) {
        return "0 KB";
    }


    const units = [
        "Bytes",
        "KB",
        "MB",
        "GB"
    ];


    const index =
        Math.floor(
            Math.log(bytes) / Math.log(1024)
        );


    return (
        parseFloat(
            (
                bytes /
                Math.pow(1024, index)
            ).toFixed(2)
        )
        + " "
        + units[index]
    );

}


/* =========================================================
   TITLE PREVIEW
========================================================= */

document
    .getElementById("galleryTitle")
    .addEventListener("input", function () {

        document
            .getElementById("previewTitle")
            .textContent =
            this.value.trim() ||
            "Gallery Title";

    });


/* =========================================================
   DESCRIPTION PREVIEW
========================================================= */

document
    .getElementById("galleryDescription")
    .addEventListener("input", function () {

        document
            .getElementById("previewDescription")
            .textContent =
            this.value.trim() ||
            "Gallery description will appear here.";

    });


/* =========================================================
   CATEGORY PREVIEW
========================================================= */

document
    .getElementById("galleryCategory")
    .addEventListener("change", function () {

        document
            .getElementById("previewCategory")
            .textContent =
            this.value ||
            "Category";

    });


/* =========================================================
   STATUS PREVIEW
========================================================= */

function updateGalleryStatus() {

    const status =
        document.getElementById("galleryStatus").value;

    const preview =
        document.getElementById("previewStatus");


    if (status === "published") {

        preview.className =
            "badge bg-success-subtle text-success";

        preview.textContent =
            "Published";

    }

    else {

        preview.className =
            "badge bg-warning-subtle text-warning-emphasis";

        preview.textContent =
            "Draft";

    }

}


/* =========================================================
   SAVE
========================================================= */

function saveGalleryItem(event) {

    event.preventDefault();


    const title =
        document
            .getElementById("galleryTitle")
            .value
            .trim();


    if (!title) {

        alert(
            "Please enter the gallery title."
        );

        return;

    }


    alert(
        "<%= mode === 'edit'
            ? 'Frontend demo: gallery item would be updated successfully.'
            : 'Frontend demo: gallery item would be saved successfully.'
        %>"
    );


    window.location.href =
        "/admin/gallery";

}

</script>


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>