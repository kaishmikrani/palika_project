                                        </span>
                                    </td>

                                </tr>


                                <tr>

                                    <td>
                                        Office Information
                                    </td>

                                    <td>
                                        05 Sep 2026
                                    </td>

                                    <td>
                                        <span class="badge bg-success">
                                            Published
                                        </span>
                                    </td>

                                </tr>

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>



            <!-- Website Status -->

            <div class="col-lg-5">

                <div class="admin-section-card">


                    <div class="admin-section-header">

                        <div>

                            <h5>
