                        class="admin-quick-action"
                    >

                        <i class="bi bi-images"></i>

                        <span>
                            Manage Slider
                        </span>

                    </a>

                </div>


            </div>

        </div>



        <!-- Recent Content -->

        <div class="row g-4">


            <!-- Recent Notices -->

            <div class="col-lg-7">

                <div class="admin-section-card">


                    <div class="admin-section-header">

                        <div>

                            <h5>
                                Recent Notices
