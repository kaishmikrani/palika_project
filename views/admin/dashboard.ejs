                        </h3>

                        <small>
                            Photos & videos
                        </small>

                    </div>

                </div>

            </div>


        </div>



        <!-- Quick Actions -->

        <div class="admin-section-card mb-4">


            <div class="admin-section-header">

                <div>

                    <h5>
                        Quick Actions
                    </h5>

                    <p>
                        Manage website content quickly
                    </p>

                </div>

            </div>


            <div class="row g-3">


                <div class="col-6 col-md-3">

                    <a
                        href="/admin/notices"
                        class="admin-quick-action"
                    >

                        <i class="bi bi-plus-circle"></i>

                        <span>
                            Add Notice
                        </span>

                    </a>

                </div>



                <div class="col-6 col-md-3">

                    <a
                        href="/admin/news"
                        class="admin-quick-action"
                    >

                        <i class="bi bi-plus-circle"></i>

                        <span>
                            Add News
                        </span>

                    </a>

                </div>



                <div class="col-6 col-md-3">

                    <a
