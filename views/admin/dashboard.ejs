                        <i class="bi bi-grid-fill"></i>

                    </div>

                    <div>

                        <span>
                            Services
                        </span>

                        <h3>
                            12
                        </h3>

                        <small>
                            Citizen services
                        </small>

                    </div>

                </div>

            </div>



            <div class="col-sm-6 col-xl-3">

                <div class="admin-stat-card">

                    <div class="admin-stat-icon purple">

                        <i class="bi bi-images"></i>

                    </div>

                    <div>

                        <span>
                            Gallery
                        </span>

                        <h3>
