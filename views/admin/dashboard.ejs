            </div>


            <div class="d-none d-sm-block">

                <strong>
                    Administrator
                </strong>

                <small>
                    Admin
                </small>

            </div>


        </div>


    </header>



    <!-- Dashboard Content -->

    <div class="admin-content">


        <!-- Statistics -->

        <div class="row g-4 mb-4">


            <div class="col-sm-6 col-xl-3">

                <div class="admin-stat-card">

                    <div class="admin-stat-icon blue">

                        <i class="bi bi-megaphone-fill"></i>

                    </div>

                    <div>

                        <span>
