<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= title %></title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
        rel="stylesheet"
    >

    <link rel="stylesheet" href="/css/style.css">

</head>


<body class="admin-page">


<!-- Sidebar -->

<aside class="admin-sidebar">

    <div class="admin-brand">

        <div class="admin-brand-icon">
            <i class="bi bi-building"></i>
        </div>

        <div>
            <h5>Bishnu Palika</h5>
            <small>Admin Panel</small>
        </div>

    </div>


    <div class="admin-menu-title">
        MAIN MENU
    </div>


    <nav class="admin-menu">

        <a href="/admin/dashboard" class="admin-menu-link">
            <i class="bi bi-grid-1x2-fill"></i>
            <span>Dashboard</span>
        </a>

        <a href="/admin/notices" class="admin-menu-link">
            <i class="bi bi-megaphone-fill"></i>
            <span>Notices</span>
        </a>

        <a href="/admin/news" class="admin-menu-link">
            <i class="bi bi-newspaper"></i>
            <span>News & Events</span>
        </a>

        <a href="/admin/services" class="admin-menu-link">
            <i class="bi bi-person-workspace"></i>
            <span>Services</span>
        </a>

        <a href="/admin/wards" class="admin-menu-link">
            <i class="bi bi-geo-alt-fill"></i>
            <span>Wards</span>
        </a>

        <a href="/admin/employees" class="admin-menu-link active">
            <i class="bi bi-people-fill"></i>
            <span>Employees</span>
        </a>

        <a href="/admin/downloads" class="admin-menu-link">
            <i class="bi bi-download"></i>
            <span>Downloads</span>
        </a>

        <a href="/admin/gallery" class="admin-menu-link">
            <i class="bi bi-images"></i>
            <span>Gallery</span>
        </a>

        <a href="/admin/slider" class="admin-menu-link">
            <i class="bi bi-sliders"></i>
            <span>Homepage Slider</span>
        </a>


        <div class="admin-menu-title">
            SETTINGS
        </div>

        <a href="/admin/profile" class="admin-menu-link">
            <i class="bi bi-person-circle"></i>
            <span>Profile</span>
        </a>

        <a href="/admin/settings" class="admin-menu-link">
            <i class="bi bi-gear-fill"></i>
            <span>Settings</span>
        </a>

        <a
            href="/"
            target="_blank"
            class="admin-menu-link"
        >
            <i class="bi bi-globe"></i>
            <span>View Website</span>
        </a>

    </nav>


    <div class="admin-sidebar-bottom">

        <a href="/admin/login">

            <i class="bi bi-box-arrow-left"></i>

            <span>Logout</span>

        </a>

    </div>

</aside>


<!-- Main -->

<main class="admin-main">


    <!-- Topbar -->

    <header class="admin-topbar">

        <div class="d-flex align-items-center gap-3">

            <button
                class="admin-mobile-menu"
                onclick="toggleAdminSidebar()"
            >
                <i class="bi bi-list"></i>
            </button>

            <div>

                <h4>
                    <%= mode === "edit"
                        ? "Edit Employee"
                        : "Add Employee"
                    %>
                </h4>

                <p>
                    <%= mode === "edit"
                        ? "Update employee information"
                        : "Add a new municipality employee"
                    %>
                </p>

            </div>

        </div>

    </header>


    <!-- Content -->

    <div class="admin-content">


        <!-- Breadcrumb -->

        <div class="admin-breadcrumb mb-4">

            <a href="/admin/dashboard">
                Dashboard
            </a>

            <i class="bi bi-chevron-right"></i>

            <a href="/admin/employees">
                Employees
            </a>

            <i class="bi bi-chevron-right"></i>

            <span>
                <%= mode === "edit" ? "Edit" : "Add" %>
            </span>

        </div>


        <form
            action="<%= mode === 'edit' ? '/admin/employees/edit/' + employee.id : '/admin/employees' %>"
            method="POST"
            enctype="multipart/form-data"
            id="employeeForm"
        >


            <div class="row g-4">


                <!-- Left -->

                <div class="col-lg-8">


                    <!-- Basic Information -->

                    <div class="admin-section-card mb-4">

                        <div class="admin-form-title">

                            <h5>
                                Basic Information
                            </h5>

                            <p>
                                Enter the employee's basic professional information.
                            </p>

                        </div>


                        <div class="row g-3">


                            <div class="col-md-6">

                                <label class="form-label">
                                    Full Name
                                    <span class="text-danger">*</span>
                                </label>

                                <input
                                    type="text"
                                    class="form-control"
                                    name="name"
                                    placeholder="Enter full name"
                                    required
                                    value="<%= employee.name || '' %>"
                                >

                            </div>


                            <div class="col-md-6">

                                <label class="form-label">
                                    Position
                                    <span class="text-danger">*</span>
                                </label>

                                <input
                                    type="text"
                                    class="form-control"
                                    name="position"
                                    placeholder="e.g. Civil Engineer"
                                    required
                                    value="<%= employee.position || '' %>"
                                >

                            </div>


                            <div class="col-md-6">

                                <label class="form-label">
                                    Employee Category
                                    <span class="text-danger">*</span>
                                </label>

                                <select class="form-select" name="category" required>

                                    <option value="">
                                        Select category
                                    </option>

                                    <option value="Administration" <%= employee.category === "Administration" ? "selected" : "" %>>
                                        Administration
                                    </option>

                                    <option value="Health" <%= employee.category === "Health" ? "selected" : "" %>>
                                        Health
                                    </option>

                                    <option value="Education" <%= employee.category === "Education" ? "selected" : "" %>>
                                        Education
                                    </option>

                                    <option value="Engineering" <%= employee.category === "Engineering" ? "selected" : "" %>>
                                        Engineering
                                    </option>

                                    <option value="Finance" <%= employee.category === "Finance" ? "selected" : "" %>>
                                        Finance
                                    </option>

                                    <option value="Agriculture" <%= employee.category === "Agriculture" ? "selected" : "" %>>
                                        Agriculture
                                    </option>

                                    <option value="IT & Records" <%= employee.category === "IT & Records" ? "selected" : "" %>>
                                        IT & Records
                                    </option>

                                    <option value="Other Staff" <%= employee.category === "Other Staff" ? "selected" : "" %>>
                                        Other Staff
                                    </option>

                                </select>

                            </div>


                            <div class="col-md-6">

                                <label class="form-label">
                                    Working Profession
                                    <span class="text-danger">*</span>
                                </label>

                                <input
                                    type="text"
                                    class="form-control"
                                    name="profession"
                                    placeholder="e.g. Civil Engineering"
                                    required
                                    value="<%= employee.profession || '' %>"
                                >

                            </div>


                            <div class="col-md-6">

                                <label class="form-label">
                                    Qualification
                                </label>

                                <input
                                    type="text"
                                    class="form-control"
                                    name="qualification"
                                    placeholder="e.g. Bachelor's Degree"
                                    value="<%= employee.qualification || '' %>"
                                >

                            </div>


                            <div class="col-md-6">

                                <label class="form-label">
                                    Experience
                                </label>

                                <input
                                    type="text"
                                    class="form-control"
                                    name="experience"
                                    placeholder="e.g. 10 Years"
                                    value="<%= employee.experience || '' %>"
                                >

                            </div>


                        </div>

                    </div>


                    <!-- Work Information -->

                    <div class="admin-section-card mb-4">

                        <div class="admin-form-title">

                            <h5>
                                Work Information
                            </h5>

                            <p>
                                Define the employee's office and professional responsibilities.
                            </p>

                        </div>


                        <div class="row g-3">


                            <div class="col-md-6">

                                <label class="form-label">
                                    Department / Section
                                </label>

                                <input
                                    type="text"
                                    class="form-control"
                                    name="department"
                                    placeholder="e.g. Engineering Section"
                                >

                            </div>


                            <div class="col-md-6">

                                <label class="form-label">
                                    Office
                                </label>

                                <input
                                    type="text"
                                    class="form-control"
                                    name="office"
                                    placeholder="e.g. Municipal Office"
                                    value="<%= employee.office || '' %>"
                                >

                            </div>


                            <div class="col-md-6">

                                <label class="form-label">
                                    Work Location
                                </label>

                                <input
                                    type="text"
                                    class="form-control"
                                    name="location"
                                    placeholder="e.g. Municipality Office"
                                >

                            </div>


                            <div class="col-md-6">

                                <label class="form-label">
                                    Ward
                                </label>

                                <select class="form-select" name="ward">

                                    <option value="Municipality Office" <%= employee.ward === "Municipality Office" ? "selected" : "" %>>
                                        Municipality Office
                                    </option>

                                    <% for(let i = 1; i <= 12; i++) { %>

                                        <option value="Ward No. <%= i %>" <%= employee.ward === `Ward No. ${i}` ? "selected" : "" %>>
                                            Ward No. <%= i %>
                                        </option>

                                    <% } %>

                                </select>

                            </div>


                            <div class="col-12">

                                <label class="form-label">
                                    Working Responsibility
                                    <span class="text-danger">*</span>
                                </label>

                                <textarea
                                    class="form-control"
                                    name="responsibility"
                                    rows="6"
                                    placeholder="Describe the employee's main responsibilities..."
                                    required
                                ><%= employee.responsibility || "" %></textarea>

                            </div>


                        </div>

                    </div>


                    <!-- Contact -->

                    <div class="admin-section-card mb-4">

                        <div class="admin-form-title">

                            <h5>
                                Contact Information
                            </h5>

                            <p>
                                Contact details that will be displayed to citizens.
                            </p>

                        </div>


                        <div class="row g-3">


                            <div class="col-md-6">

                                <label class="form-label">
                                    Phone Number
                                </label>

                                <input
                                    type="tel"
                                    class="form-control"
                                    name="phone"
                                    placeholder="98XXXXXXXX"
                                    value="<%= employee.phone || '' %>"
                                >

                            </div>


                            <div class="col-md-6">

                                <label class="form-label">
                                    Email Address
                                </label>

                                <input
                                    type="email"
                                    class="form-control"
                                    name="email"
                                    placeholder="employee@example.com"
                                    value="<%= employee.email || '' %>"
                                >

                            </div>


                        </div>

                    </div>


                    <!-- Status -->

                    <div class="admin-section-card">

                        <div class="admin-form-title">

                            <h5>
                                Publication Status
                            </h5>

                            <p>
                                Control whether this employee appears on the public website.
                            </p>

                        </div>


                        <div class="form-check form-switch">

                            <input
                                class="form-check-input"
                                type="checkbox"
                                id="employeeStatus"
                                name="active"
                                <%= employee.active !== false ? "checked" : "" %>
                            >

                            <label
                                class="form-check-label"
                                for="employeeStatus"
                            >
                                <strong>Active Employee</strong>

                                <small class="d-block text-muted">
                                    Active employees are visible on the public Employees page.
                                </small>

                            </label>

                        </div>

                    </div>


                </div>


                <!-- Right -->

                <div class="col-lg-4">


                    <!-- Photo -->

                    <div class="admin-section-card mb-4">

                        <div class="admin-form-title">

                            <h5>
                                Employee Photo
                            </h5>

                            <p>
                                Upload a professional employee photograph.
                            </p>

                        </div>


                        <div class="employee-photo-preview">

                            <div id="employeePhotoPlaceholder">

                                <i class="bi bi-person-fill"></i>

                                <span>
                                    No photo selected
                                </span>

                            </div>


                            <img
                                id="employeePhotoPreview"
                                class="d-none"
                                alt="Employee Preview"
                            >

                        </div>


                        <label class="admin-upload-box employee-upload-box">

                            <i class="bi bi-cloud-arrow-up"></i>

                            <h6>
                                Upload Photo
                            </h6>

                            <p>
                                JPG or PNG recommended
                            </p>

                            <span class="btn btn-outline-primary btn-sm">
                                Choose Photo
                            </span>

                            <input
                                type="file"
                                class="d-none"
                                name="image"
                                accept="image/jpeg,image/png"
                                onchange="previewEmployeePhoto(event)"
                            >

                        </label>

                    </div>


                    <!-- Preview -->

                    <div class="admin-section-card mb-4">

                        <div class="admin-form-title">

                            <h5>
                                Public Profile Preview
                            </h5>

                            <p>
                                Preview how the employee appears on the website.
                            </p>

                        </div>


                        <div class="employee-mini-preview">

                            <div class="employee-mini-image">

                                <i
                                    class="bi bi-person-fill"
                                    id="miniPreviewIcon"
                                ></i>

                                <img
                                    id="miniPreviewImage"
                                    class="d-none"
                                >

                            </div>


                            <div>

                                <strong id="previewName">
                                    Employee Name
                                </strong>

                                <small id="previewPosition">
                                    Employee Position
                                </small>

                                <span id="previewCategory">
                                    Department
                                </span>

                            </div>

                        </div>

                    </div>


                    <!-- Guide -->

                    <div class="admin-section-card">

                        <div class="admin-form-title">

                            <h5>
                                Publishing Guide
                            </h5>

                        </div>


                        <div class="admin-guide-item">

                            <i class="bi bi-1-circle-fill"></i>

                            <div>

                                <strong>
                                    Enter accurate details
                                </strong>

                                <p>
                                    Make sure the name, position and contact information are correct.
                                </p>

                            </div>

                        </div>


                        <div class="admin-guide-item">

                            <i class="bi bi-2-circle-fill"></i>

                            <div>

                                <strong>
                                    Add professional responsibility
                                </strong>

                                <p>
                                    Explain what citizens can contact the employee about.
                                </p>

                            </div>

                        </div>


                        <div class="admin-guide-item">

                            <i class="bi bi-3-circle-fill"></i>

                            <div>

                                <strong>
                                    Upload a clear photo
                                </strong>

                                <p>
                                    Use an official professional photograph.
                                </p>

                            </div>

                        </div>

                    </div>


                </div>

            </div>


            <!-- Buttons -->

            <div class="d-flex justify-content-end gap-2 mt-4">

                <a
                    href="/admin/employees"
                    class="btn btn-outline-secondary"
                >
                    Cancel
                </a>

                <button
                    type="submit"
                    class="btn btn-primary"
                >

                    <i class="bi bi-check-lg me-1"></i>

                    <%= mode === "edit"
                        ? "Update Employee"
                        : "Save Employee"
                    %>

                </button>

            </div>


        </form>

    </div>

</main>


<script>

function toggleAdminSidebar() {

    document
        .querySelector(".admin-sidebar")
        .classList.toggle("show");

}


function previewEmployeePhoto(event) {

    const file =
        event.target.files[0];

    if (!file) return;


    const preview =
        document.getElementById(
            "employeePhotoPreview"
        );

    const placeholder =
        document.getElementById(
            "employeePhotoPlaceholder"
        );

    const miniImage =
        document.getElementById(
            "miniPreviewImage"
        );

    const miniIcon =
        document.getElementById(
            "miniPreviewIcon"
        );


    const imageUrl =
        URL.createObjectURL(file);


    preview.src = imageUrl;

    preview.classList.remove("d-none");

    placeholder.classList.add("d-none");


    miniImage.src = imageUrl;

    miniImage.classList.remove("d-none");

    miniIcon.classList.add("d-none");

}


const employeeNameInput =
    document.querySelector(
        'input[placeholder="Enter full name"]'
    );

const employeePositionInput =
    document.querySelector(
        'input[placeholder="e.g. Civil Engineer"]'
    );

const employeeCategorySelect =
    document.querySelector(
        'select'
    );


if (employeeNameInput) {

    employeeNameInput.addEventListener(
        "input",
        function () {

            document.getElementById(
                "previewName"
            ).textContent =
                this.value || "Employee Name";

        }
    );

}


if (employeePositionInput) {

    employeePositionInput.addEventListener(
        "input",
        function () {

            document.getElementById(
                "previewPosition"
            ).textContent =
                this.value || "Employee Position";

        }
    );

}


if (employeeCategorySelect) {

    employeeCategorySelect.addEventListener(
        "change",
        function () {

            document.getElementById(
                "previewCategory"
            ).textContent =
                this.value || "Department";

        }
    );

}

</script>


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>