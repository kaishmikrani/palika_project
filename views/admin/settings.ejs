<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= title || "Admin Settings" %></title>

    <!-- Bootstrap -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <!-- Bootstrap Icons -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
        rel="stylesheet"
    >

    <!-- Main CSS -->
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="admin-page">

    <!-- =========================================
         SIDEBAR
    ========================================== -->
    <aside class="admin-sidebar">

        <div class="admin-brand">

            <div class="admin-brand-icon">
                <i class="bi bi-building"></i>
            </div>

            <div>
                <h5>Bishnu Palika</h5>
                <small>Admin Panel</small>
            </div>

        </div>


        <div class="admin-menu-title">
            MAIN MENU
        </div>


        <nav class="admin-menu">

            <a href="/admin/dashboard" class="admin-menu-link">
                <i class="bi bi-grid-1x2-fill"></i>
                <span>Dashboard</span>
            </a>

            <a href="/admin/notices" class="admin-menu-link">
                <i class="bi bi-megaphone-fill"></i>
                <span>Notices</span>
            </a>

            <a href="/admin/news" class="admin-menu-link">
                <i class="bi bi-newspaper"></i>
                <span>News & Events</span>
            </a>

            <a href="/admin/services" class="admin-menu-link">
                <i class="bi bi-person-workspace"></i>
                <span>Services</span>
            </a>

            <a href="/admin/wards" class="admin-menu-link">
                <i class="bi bi-geo-alt-fill"></i>
                <span>Wards</span>
            </a>

            <a href="/admin/downloads" class="admin-menu-link">
                <i class="bi bi-download"></i>
                <span>Downloads</span>
            </a>

            <a href="/admin/gallery" class="admin-menu-link">
                <i class="bi bi-images"></i>
                <span>Gallery</span>
            </a>

            <a href="/admin/slider" class="admin-menu-link">
                <i class="bi bi-sliders"></i>
                <span>Homepage Slider</span>
            </a>


            <div class="admin-menu-title">
                SETTINGS
            </div>


            <a href="/admin/profile" class="admin-menu-link">
                <i class="bi bi-person-circle"></i>
                <span>Profile</span>
            </a>

            <a href="/admin/settings" class="admin-menu-link active">
                <i class="bi bi-gear-fill"></i>
                <span>Settings</span>
            </a>

            <a href="/" target="_blank" class="admin-menu-link">
                <i class="bi bi-globe"></i>
                <span>View Website</span>
            </a>

        </nav>


        <div class="admin-sidebar-bottom">

            <a href="/admin/login">
                <i class="bi bi-box-arrow-left"></i>
                <span>Logout</span>
            </a>

        </div>

    </aside>


    <!-- =========================================
         MAIN
    ========================================== -->
    <main class="admin-main">

        <!-- TOPBAR -->
        <div class="admin-topbar">

            <div class="d-flex align-items-center gap-3">

                <button
                    type="button"
                    class="admin-mobile-menu"
                    onclick="toggleAdminSidebar()"
                >
                    <i class="bi bi-list"></i>
                </button>

                <div>

                    <h4>Admin Settings</h4>

                    <p>
                        Configure your municipality website and admin preferences
                    </p>

                </div>

            </div>


            <!-- ADMIN USER -->
            <div class="admin-user d-none d-sm-flex">

                <div class="admin-user-icon">
                    <i class="bi bi-person-fill"></i>
                </div>

                <div>

                    <strong>Administrator</strong>

                    <small>
                        Super Admin
                    </small>

                </div>

            </div>

        </div>


        <!-- =========================================
             CONTENT
        ========================================== -->
        <div class="admin-content">

            <!-- BREADCRUMB -->
            <div class="admin-breadcrumb mb-4">

                <a href="/admin/dashboard">
                    Dashboard
                </a>

                <i class="bi bi-chevron-right"></i>

                <span>
                    Settings
                </span>

            </div>


            <!-- SETTINGS INTRO -->
            <div class="settings-intro-card mb-4">

                <div class="settings-intro-icon">
                    <i class="bi bi-gear-wide-connected"></i>
                </div>

                <div>

                    <h5>
                        Website Configuration
                    </h5>

                    <p>
                        Manage general website information, homepage behavior,
                        notifications and administrative preferences.
                    </p>

                </div>

            </div>


            <form id="settingsForm">

                <div class="row g-4">


                    <!-- =================================
                         GENERAL SETTINGS
                    ================================== -->
                    <div class="col-12">

                        <div class="admin-section-card">

                            <div class="admin-section-header">

                                <div>

                                    <h5>
                                        General Settings
                                    </h5>

                                    <p>
                                        Basic information about Bishnu Rural Municipality.
                                    </p>

                                </div>

                                <i class="bi bi-building text-primary fs-4"></i>

                            </div>


                            <div class="row g-3">

                                <!-- MUNICIPALITY NAME -->
                                <div class="col-md-6">

                                    <label class="form-label">
                                        Municipality Name
                                    </label>

                                    <input
                                        type="text"
                                        class="form-control"
                                        value="Bishnu Rural Municipality"
                                        placeholder="Enter municipality name"
                                    >

                                </div>


                                <!-- WEBSITE TITLE -->
                                <div class="col-md-6">

                                    <label class="form-label">
                                        Website Title
                                    </label>

                                    <input
                                        type="text"
                                        class="form-control"
                                        value="Bishnu Rural Municipality"
                                        placeholder="Enter website title"
                                    >

                                </div>


                                <!-- TAGLINE -->
                                <div class="col-md-12">

                                    <label class="form-label">
                                        Website Tagline
                                    </label>

                                    <input
                                        type="text"
                                        class="form-control"
                                        value="Official Website of Bishnu Rural Municipality"
                                        placeholder="Enter website tagline"
                                    >

                                </div>


                                <!-- EMAIL -->
                                <div class="col-md-6">

                                    <label class="form-label">
                                        Official Email
                                    </label>

                                    <input
                                        type="email"
                                        class="form-control"
                                        value="info@bishnupalika.gov.np"
                                        placeholder="Enter official email"
                                    >

                                </div>


                                <!-- PHONE -->
                                <div class="col-md-6">

                                    <label class="form-label">
                                        Official Phone
                                    </label>

                                    <input
                                        type="tel"
                                        class="form-control"
                                        value="+977-XXXXXXXXXX"
                                        placeholder="Enter official phone"
                                    >

                                </div>


                                <!-- ADDRESS -->
                                <div class="col-md-8">

                                    <label class="form-label">
                                        Office Address
                                    </label>

                                    <input
                                        type="text"
                                        class="form-control"
                                        value="Bishnu Rural Municipality, Nepal"
                                        placeholder="Enter office address"
                                    >

                                </div>


                                <!-- POSTAL CODE -->
                                <div class="col-md-4">

                                    <label class="form-label">
                                        Postal Code
                                    </label>

                                    <input
                                        type="text"
                                        class="form-control"
                                        placeholder="Enter postal code"
                                    >

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- =================================
                         WEBSITE STATUS
                    ================================== -->
                    <div class="col-lg-6">

                        <div class="admin-section-card h-100">

                            <div class="admin-section-header">

                                <div>

                                    <h5>
                                        Website Status
                                    </h5>

                                    <p>
                                        Control the public availability of the website.
                                    </p>

                                </div>

                                <i class="bi bi-globe2 text-primary fs-4"></i>

                            </div>


                            <!-- PUBLIC WEBSITE -->
                            <div class="settings-toggle-item">

                                <div class="settings-toggle-icon">
                                    <i class="bi bi-globe"></i>
                                </div>

                                <div class="settings-toggle-content">

                                    <strong>
                                        Public Website
                                    </strong>

                                    <small>
                                        Allow visitors to access the website.
                                    </small>

                                </div>

                                <div class="form-check form-switch">

                                    <input
                                        class="form-check-input settings-switch"
                                        type="checkbox"
                                        id="publicWebsite"
                                        checked
                                    >

                                </div>

                            </div>


                            <!-- MAINTENANCE -->
                            <div class="settings-toggle-item">

                                <div class="settings-toggle-icon warning">
                                    <i class="bi bi-tools"></i>
                                </div>

                                <div class="settings-toggle-content">

                                    <strong>
                                        Maintenance Mode
                                    </strong>

                                    <small>
                                        Temporarily show a maintenance page.
                                    </small>

                                </div>

                                <div class="form-check form-switch">

                                    <input
                                        class="form-check-input settings-switch"
                                        type="checkbox"
                                        id="maintenanceMode"
                                    >

                                </div>

                            </div>


                            <div
                                class="settings-warning-box mt-3"
                                id="maintenanceWarning"
                            >

                                <i class="bi bi-exclamation-triangle-fill"></i>

                                <div>

                                    <strong>
                                        Maintenance Mode
                                    </strong>

                                    <p>
                                        Visitors may not be able to access
                                        the normal website while this mode is active.
                                    </p>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- =================================
                         HOMEPAGE SETTINGS
                    ================================== -->
                    <div class="col-lg-6">

                        <div class="admin-section-card h-100">

                            <div class="admin-section-header">

                                <div>

                                    <h5>
                                        Homepage Settings
                                    </h5>

                                    <p>
                                        Control homepage content visibility.
                                    </p>

                                </div>

                                <i class="bi bi-house text-primary fs-4"></i>

                            </div>


                            <!-- AUTO SLIDER -->
                            <div class="settings-toggle-item">

                                <div class="settings-toggle-icon">
                                    <i class="bi bi-sliders"></i>
                                </div>

                                <div class="settings-toggle-content">

                                    <strong>
                                        Auto Homepage Slider
                                    </strong>

                                    <small>
                                        Automatically rotate homepage slides.
                                    </small>

                                </div>

                                <div class="form-check form-switch">

                                    <input
                                        class="form-check-input settings-switch"
                                        type="checkbox"
                                        id="autoSlider"
                                        checked
                                    >

                                </div>

                            </div>


                            <!-- SHOW NOTICES -->
                            <div class="settings-toggle-item">

                                <div class="settings-toggle-icon">
                                    <i class="bi bi-megaphone"></i>
                                </div>

                                <div class="settings-toggle-content">

                                    <strong>
                                        Show Latest Notices
                                    </strong>

                                    <small>
                                        Display recent notices on homepage.
                                    </small>

                                </div>

                                <div class="form-check form-switch">

                                    <input
                                        class="form-check-input settings-switch"
                                        type="checkbox"
                                        checked
                                    >

                                </div>

                            </div>


                            <!-- SHOW NEWS -->
                            <div class="settings-toggle-item">

                                <div class="settings-toggle-icon">
                                    <i class="bi bi-newspaper"></i>
                                </div>

                                <div class="settings-toggle-content">

                                    <strong>
                                        Show Latest News
                                    </strong>

                                    <small>
                                        Display recent news and events.
                                    </small>

                                </div>

                                <div class="form-check form-switch">

                                    <input
                                        class="form-check-input settings-switch"
                                        type="checkbox"
                                        checked
                                    >

                                </div>

                            </div>


                            <!-- SLIDER INTERVAL -->
                            <div class="mt-3">

                                <label class="form-label">
                                    Slider Interval
                                </label>

                                <select class="form-select">

                                    <option value="3000">
                                        3 Seconds
                                    </option>

                                    <option value="5000" selected>
                                        5 Seconds
                                    </option>

                                    <option value="7000">
                                        7 Seconds
                                    </option>

                                    <option value="10000">
                                        10 Seconds
                                    </option>

                                </select>

                            </div>

                        </div>

                    </div>


                    <!-- =================================
                         NOTIFICATION SETTINGS
                    ================================== -->
                    <div class="col-lg-6">

                        <div class="admin-section-card h-100">

                            <div class="admin-section-header">

                                <div>

                                    <h5>
                                        Notification Settings
                                    </h5>

                                    <p>
                                        Choose which administrative alerts you receive.
                                    </p>

                                </div>

                                <i class="bi bi-bell text-primary fs-4"></i>

                            </div>


                            <!-- EMAIL NOTIFICATIONS -->
                            <div class="settings-toggle-item">

                                <div class="settings-toggle-icon">
                                    <i class="bi bi-envelope"></i>
                                </div>

                                <div class="settings-toggle-content">

                                    <strong>
                                        Email Notifications
                                    </strong>

                                    <small>
                                        Receive administrative notifications by email.
                                    </small>

                                </div>

                                <div class="form-check form-switch">

                                    <input
                                        class="form-check-input settings-switch"
                                        type="checkbox"
                                        checked
                                    >

                                </div>

                            </div>


                            <!-- NEW NOTICE -->
                            <div class="settings-toggle-item">

                                <div class="settings-toggle-icon">
                                    <i class="bi bi-megaphone"></i>
                                </div>

                                <div class="settings-toggle-content">

                                    <strong>
                                        New Notice Alert
                                    </strong>

                                    <small>
                                        Notify when a new notice is published.
                                    </small>

                                </div>

                                <div class="form-check form-switch">

                                    <input
                                        class="form-check-input settings-switch"
                                        type="checkbox"
                                        checked
                                    >

                                </div>

                            </div>


                            <!-- CONTACT ALERT -->
                            <div class="settings-toggle-item">

                                <div class="settings-toggle-icon">
                                    <i class="bi bi-chat-left-text"></i>
                                </div>

                                <div class="settings-toggle-content">

                                    <strong>
                                        Contact Form Alerts
                                    </strong>

                                    <small>
                                        Notify administrators about new messages.
                                    </small>

                                </div>

                                <div class="form-check form-switch">

                                    <input
                                        class="form-check-input settings-switch"
                                        type="checkbox"
                                        checked
                                    >

                                </div>

                            </div>


                            <!-- NEWS ALERT -->
                            <div class="settings-toggle-item">

                                <div class="settings-toggle-icon">
                                    <i class="bi bi-newspaper"></i>
                                </div>

                                <div class="settings-toggle-content">

                                    <strong>
                                        News Publishing Alerts
                                    </strong>

                                    <small>
                                        Receive alerts when news is published.
                                    </small>

                                </div>

                                <div class="form-check form-switch">

                                    <input
                                        class="form-check-input settings-switch"
                                        type="checkbox"
                                    >

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- =================================
                         SECURITY SETTINGS
                    ================================== -->
                    <div class="col-lg-6">

                        <div class="admin-section-card h-100">

                            <div class="admin-section-header">

                                <div>

                                    <h5>
                                        Security Settings
                                    </h5>

                                    <p>
                                        Configure administrator security preferences.
                                    </p>

                                </div>

                                <i class="bi bi-shield-lock text-primary fs-4"></i>

                            </div>


                            <!-- SESSION TIMEOUT -->
                            <div class="mb-3">

                                <label class="form-label">
                                    Session Timeout
                                </label>

                                <select class="form-select">

                                    <option>
                                        15 Minutes
                                    </option>

                                    <option selected>
                                        30 Minutes
                                    </option>

                                    <option>
                                        1 Hour
                                    </option>

                                    <option>
                                        2 Hours
                                    </option>

                                    <option>
                                        4 Hours
                                    </option>

                                </select>

                                <div class="form-text">
                                    Automatically log out inactive administrators.
                                </div>

                            </div>


                            <!-- LOGIN ALERT -->
                            <div class="settings-toggle-item">

                                <div class="settings-toggle-icon">
                                    <i class="bi bi-box-arrow-in-right"></i>
                                </div>

                                <div class="settings-toggle-content">

                                    <strong>
                                        Login Alerts
                                    </strong>

                                    <small>
                                        Notify when an administrator logs in.
                                    </small>

                                </div>

                                <div class="form-check form-switch">

                                    <input
                                        class="form-check-input settings-switch"
                                        type="checkbox"
                                        checked
                                    >

                                </div>

                            </div>


                            <!-- MULTIPLE LOGIN -->
                            <div class="settings-toggle-item">

                                <div class="settings-toggle-icon">
                                    <i class="bi bi-pc-display"></i>
                                </div>

                                <div class="settings-toggle-content">

                                    <strong>
                                        Multiple Login Detection
                                    </strong>

                                    <small>
                                        Detect simultaneous administrator sessions.
                                    </small>

                                </div>

                                <div class="form-check form-switch">

                                    <input
                                        class="form-check-input settings-switch"
                                        type="checkbox"
                                        checked
                                    >

                                </div>

                            </div>


                            <div class="settings-security-note mt-3">

                                <i class="bi bi-shield-check"></i>

                                <div>

                                    <strong>
                                        Security Notice
                                    </strong>

                                    <p>
                                        Authentication, session handling and
                                        access control will be connected during
                                        the backend development phase.
                                    </p>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- =================================
                         APPEARANCE / LOCALIZATION
                    ================================== -->
                    <div class="col-12">

                        <div class="admin-section-card">

                            <div class="admin-section-header">

                                <div>

                                    <h5>
                                        Appearance & Localization
                                    </h5>

                                    <p>
                                        Configure language, timezone and date preferences.
                                    </p>

                                </div>

                                <i class="bi bi-palette text-primary fs-4"></i>

                            </div>


                            <div class="row g-3">

                                <!-- LANGUAGE -->
                                <div class="col-md-4">

                                    <label class="form-label">
                                        Website Language
                                    </label>

                                    <select class="form-select">

                                        <option selected>
                                            English
                                        </option>

                                        <option>
                                            नेपाली
                                        </option>

                                        <option>
                                            English + नेपाली
                                        </option>

                                    </select>

                                </div>


                                <!-- TIMEZONE -->
                                <div class="col-md-4">

                                    <label class="form-label">
                                        Timezone
                                    </label>

                                    <select class="form-select">

                                        <option selected>
                                            Asia/Kathmandu
                                        </option>

                                        <option>
                                            Asia/Kolkata
                                        </option>

                                        <option>
                                            UTC
                                        </option>

                                    </select>

                                </div>


                                <!-- DATE FORMAT -->
                                <div class="col-md-4">

                                    <label class="form-label">
                                        Date Format
                                    </label>

                                    <select class="form-select">

                                        <option selected>
                                            YYYY-MM-DD
                                        </option>

                                        <option>
                                            DD-MM-YYYY
                                        </option>

                                        <option>
                                            MM-DD-YYYY
                                        </option>

                                    </select>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- =================================
                         ADMIN ACTIONS
                    ================================== -->
                    <div class="col-12">

                        <div class="settings-action-bar">

                            <div>

                                <strong>
                                    Save Configuration
                                </strong>

                                <small>
                                    Settings are currently displayed as
                                    frontend demo controls.
                                </small>

                            </div>


                            <div class="d-flex gap-2">

                                <button
                                    type="button"
                                    class="btn btn-outline-secondary"
                                    onclick="resetSettings()"
                                >
                                    <i class="bi bi-arrow-counterclockwise me-1"></i>
                                    Reset
                                </button>


                                <button
                                    type="submit"
                                    class="btn btn-primary"
                                >
                                    <i class="bi bi-check2-circle me-1"></i>
                                    Save Settings
                                </button>

                            </div>

                        </div>

                    </div>

                </div>

            </form>

        </div>

    </main>


    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>


    <script>

        // Mobile sidebar
        function toggleAdminSidebar() {

            document
                .querySelector(".admin-sidebar")
                .classList.toggle("show");

        }


        // Maintenance mode warning
        const maintenanceMode =
            document.getElementById("maintenanceMode");

        const maintenanceWarning =
            document.getElementById("maintenanceWarning");


        function updateMaintenanceWarning() {

            if (maintenanceMode.checked) {

                maintenanceWarning.classList.add("show");

            } else {

                maintenanceWarning.classList.remove("show");

            }

        }


        maintenanceMode.addEventListener(
            "change",
            updateMaintenanceWarning
        );


        // Initial state
        updateMaintenanceWarning();


        // Settings form
        document
            .getElementById("settingsForm")
            .addEventListener("submit", function(event) {

                event.preventDefault();

                alert(
                    "Settings saved successfully! " +
                    "(Frontend demo only)"
                );

            });


        // Reset
        function resetSettings() {

            const confirmed = confirm(
                "Are you sure you want to reset the settings?"
            );

            if (!confirmed) return;

            document
                .getElementById("settingsForm")
                .reset();

            updateMaintenanceWarning();

            alert(
                "Settings have been reset. " +
                "(Frontend demo only)"
            );

        }

    </script>

</body>
</html>