
<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= title %> | Bishnu Rural Municipality</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

</head>


<body class="admin-page">


<!-- SIDEBAR -->

<aside class="admin-sidebar">

    <div class="admin-brand">

        <div class="admin-brand-icon">
            <i class="bi bi-building-fill"></i>
        </div>

        <div>

            <h5>Bishnu Rural</h5>

            <small>Administration</small>

        </div>

    </div>


    <div class="admin-menu-title">
        MAIN MENU
    </div>


    <nav class="admin-menu">

        <a href="/admin/dashboard" class="admin-menu-link">
            <i class="bi bi-speedometer2"></i>
            <span>Dashboard</span>
        </a>

        <a href="/admin/notices" class="admin-menu-link active">
            <i class="bi bi-megaphone"></i>
            <span>Notices</span>
        </a>

        <a href="/admin/news" class="admin-menu-link">
            <i class="bi bi-newspaper"></i>
            <span>News & Events</span>
        </a>

        <a href="/admin/services" class="admin-menu-link">
            <i class="bi bi-grid"></i>
            <span>Services</span>
        </a>

        <a href="/admin/wards" class="admin-menu-link">
            <i class="bi bi-diagram-3"></i>
            <span>Wards</span>
        </a>

        <a href="/admin/downloads" class="admin-menu-link">
            <i class="bi bi-file-earmark-arrow-down"></i>
            <span>Downloads</span>
        </a>

        <a href="/admin/gallery" class="admin-menu-link">
            <i class="bi bi-images"></i>
            <span>Gallery</span>
        </a>

        <a href="/admin/slider" class="admin-menu-link">
            <i class="bi bi-images"></i>
            <span>Homepage Slider</span>
        </a>

    </nav>


    <div class="admin-sidebar-bottom">

        <a href="/admin/login">

            <i class="bi bi-box-arrow-right"></i>

            Logout

        </a>

    </div>

</aside>



<!-- MAIN -->

<main class="admin-main">


    <header class="admin-topbar">

        <button
            class="admin-mobile-menu"
            onclick="toggleAdminSidebar()"
        >
            <i class="bi bi-list"></i>
        </button>


        <div>

            <h4>
                <%= mode === "edit" ? "Edit Notice" : "Add Notice" %>
            </h4>

            <p>
                <%= mode === "edit"
                    ? "Update notice information"
                    : "Create a new municipality notice"
                %>
            </p>

        </div>


        <div class="admin-user">

            <div class="admin-user-icon">

                <i class="bi bi-person-fill"></i>

            </div>

            <div class="d-none d-sm-block">

                <strong>
                    Administrator
                </strong>

                <small>
                    Admin
                </small>

            </div>

        </div>

    </header>



    <div class="admin-content">


        <!-- Breadcrumb -->

        <div class="admin-breadcrumb mb-4">

            <a href="/admin/dashboard">
                Dashboard
            </a>

            <i class="bi bi-chevron-right"></i>

            <a href="/admin/notices">
                Notices
            </a>

            <i class="bi bi-chevron-right"></i>

            <span>
                <%= mode === "edit" ? "Edit" : "Add" %>
            </span>

        </div>



        <div class="row g-4">


            <!-- FORM -->

            <div class="col-lg-8">

                <div class="admin-section-card">


                    <div class="admin-form-title">

                        <h5>
                            Notice Information
                        </h5>

                        <p>
                            Fill in the details below.
                        </p>

                    </div>


                    <form action="#" method="POST">


                        <!-- Title -->

                        <div class="mb-4">

                            <label class="form-label">
                                Notice Title
                                <span class="text-danger">*</span>
                            </label>

                            <input
                                type="text"
                                class="form-control"
                                placeholder="Enter notice title"
                                value="<%= mode === 'edit' ? 'Public Notice Regarding Municipal Services' : '' %>"
                                required
                            >

                        </div>



                        <!-- Category -->

                        <div class="row g-3 mb-4">

                            <div class="col-md-6">

                                <label class="form-label">
                                    Category
                                    <span class="text-danger">*</span>
                                </label>

                                <select
                                    class="form-select"
                                    required
                                >

                                    <option value="">
                                        Select category
                                    </option>

                                    <option>
                                        Public Notice
                                    </option>

                                    <option>
                                        Tender
                                    </option>

                                    <option>
                                        Vacancy
                                    </option>

                                    <option>
                                        Information
                                    </option>

                                    <option>
                                        Important
                                    </option>

                                </select>

                            </div>


                            <div class="col-md-6">

                                <label class="form-label">
                                    Publication Date
                                </label>

                                <input
                                    type="date"
                                    class="form-control"
                                >

                            </div>

                        </div>



                        <!-- Content -->

                        <div class="mb-4">

                            <label class="form-label">
                                Notice Content
                                <span class="text-danger">*</span>
                            </label>

                            <textarea
                                class="form-control"
                                rows="10"
                                placeholder="Write notice content here..."
                                required
                            ></textarea>

                            <div class="form-text">
                                Enter the complete notice information
                                that citizens need to know.
                            </div>

                        </div>



                        <!-- Attachment -->

                        <div class="mb-4">

                            <label class="form-label">
                                Attachment
                            </label>

                            <div class="admin-upload-box">

                                <i class="bi bi-cloud-arrow-up"></i>

                                <h6>
                                    Upload Notice Document
                                </h6>

                                <p>
                                    PDF, DOC or DOCX files
                                </p>

                                <input
                                    type="file"
                                    class="form-control"
                                    accept=".pdf,.doc,.docx"
                                >

                            </div>

                        </div>



                        <!-- Important -->

                        <div class="form-check form-switch mb-4">

                            <input
                                class="form-check-input"
                                type="checkbox"
                                id="importantNotice"
                            >

                            <label
                                class="form-check-label"
                                for="importantNotice"
                            >
                                Mark as important notice
                            </label>

                        </div>



                        <!-- Status -->

                        <div class="mb-4">

                            <label class="form-label">
                                Status
                            </label>

                            <select class="form-select">

                                <option>
                                    Draft
                                </option>

                                <option>
                                    Published
                                </option>

                            </select>

                        </div>



                        <!-- Buttons -->

                        <div class="d-flex gap-2">

                            <button
                                type="submit"
                                class="btn btn-primary"
                            >

                                <i class="bi bi-check-lg me-2"></i>

                                <%= mode === "edit"
                                    ? "Update Notice"
                                    : "Save Notice"
                                %>

                            </button>


                            <a
                                href="/admin/notices"
                                class="btn btn-light"
                            >

                                Cancel

                            </a>

                        </div>


                    </form>

                </div>

            </div>



            <!-- SIDE INFORMATION -->

            <div class="col-lg-4">


                <div class="admin-section-card mb-4">

                    <div class="admin-form-title">

                        <h5>
                            Publishing Guide
                        </h5>

                    </div>


                    <div class="admin-guide-item">

                        <i class="bi bi-1-circle-fill"></i>

                        <div>

                            <strong>
                                Write a clear title
                            </strong>

                            <p>
                                Keep the notice title short
                                and easy to understand.
                            </p>

                        </div>

                    </div>


                    <div class="admin-guide-item">

                        <i class="bi bi-2-circle-fill"></i>

                        <div>

                            <strong>
                                Select category
                            </strong>

                            <p>
                                Choose the category that
                                best matches the notice.
                            </p>

                        </div>

                    </div>


                    <div class="admin-guide-item">

                        <i class="bi bi-3-circle-fill"></i>

                        <div>

                            <strong>
                                Add attachment
                            </strong>

                            <p>
                                Upload an official document
                                when required.
                            </p>

                        </div>

                    </div>


                    <div class="admin-guide-item">

                        <i class="bi bi-4-circle-fill"></i>

                        <div>

                            <strong>
                                Publish
                            </strong>

                            <p>
                                Choose Published when the
                                notice is ready for citizens.
                            </p>

                        </div>

                    </div>

                </div>



                <div class="admin-section-card">

                    <div class="admin-form-title">

                        <h5>
                            Notice Status
                        </h5>

                    </div>


                    <div class="notice-status-preview">

                        <div>

                            <span>
                                Current Status
                            </span>

                            <strong>
                                <%= mode === "edit"
                                    ? "Published"
                                    : "Draft"
                                %>
                            </strong>

                        </div>

                        <i class="bi bi-megaphone-fill"></i>

                    </div>

                </div>


            </div>


        </div>

    </div>

</main>



<script>

function toggleAdminSidebar() {

    document
        .querySelector(".admin-sidebar")
        .classList.toggle("show");

}

</script>


</body>

</html>
