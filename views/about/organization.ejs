<%- include("../layouts/header") %>

<%- include("../layouts/navbar") %>


<!-- Page Header -->
<section class="page-header">

    <div class="container">

        <h1>Organizational Structure</h1>

        <nav aria-label="breadcrumb">

            <ol class="breadcrumb mb-0">

                <li class="breadcrumb-item">
                    <a href="/">Home</a>
                </li>

                <li class="breadcrumb-item">
                    <a href="/about">About Us</a>
                </li>

                <li class="breadcrumb-item active">
                    Organizational Structure
                </li>

            </ol>

        </nav>

    </div>

</section>



<!-- Organization -->
<section class="py-5">

    <div class="container">

        <div class="text-center mb-5">

            <span class="section-subtitle">
                Municipality Administration
            </span>

            <h2 class="section-title">
                Organizational Structure
            </h2>

            <p class="text-muted">
                Structure of the municipal administration and
                major functional sections.
            </p>

        </div>


        <!-- Main Level -->
        <div class="organization-tree">

            <div class="organization-box main">

                <div class="organization-icon">
                    <i class="bi bi-building-fill"></i>
                </div>

                <h4>
                    Rural Municipality
                </h4>

                <p>
                    Local Government
                </p>

            </div>


            <div class="organization-line"></div>


            <!-- Leadership -->
            <div class="row justify-content-center g-4">

                <div class="col-md-5 col-lg-4">

                    <div class="organization-box">

                        <div class="organization-icon">
                            <i class="bi bi-person-fill"></i>
                        </div>

                        <h5>
                            Chairperson
                        </h5>

                        <p>
                            Municipal Executive Leadership
                        </p>

                    </div>

                </div>


                <div class="col-md-5 col-lg-4">

                    <div class="organization-box">

                        <div class="organization-icon">
                            <i class="bi bi-person-badge-fill"></i>
                        </div>

                        <h5>
                            Vice Chairperson
                        </h5>

                        <p>
                            Municipal Executive
                        </p>

                    </div>

                </div>

            </div>


            <div class="organization-line"></div>


            <!-- Administration -->
            <div class="organization-box administration">

                <div class="organization-icon">
                    <i class="bi bi-person-workspace"></i>
                </div>

                <h5>
                    Chief Administrative Officer
                </h5>

                <p>
                    Municipal Administration
                </p>

            </div>


            <div class="organization-line"></div>


            <!-- Departments -->
            <div class="row g-4">

                <div class="col-md-6 col-lg-4">

                    <div class="department-card">

                        <i class="bi bi-file-earmark-text-fill"></i>

                        <h5>
                            Administration Section
                        </h5>

                        <p>
                            General administration,
                            correspondence and records.
                        </p>

                    </div>

                </div>


                <div class="col-md-6 col-lg-4">

                    <div class="department-card">

                        <i class="bi bi-cash-stack"></i>

                        <h5>
                            Finance Section
                        </h5>

                        <p>
                            Budget, revenue, accounting
                            and financial administration.
                        </p>

                    </div>

                </div>


                <div class="col-md-6 col-lg-4">

                    <div class="department-card">

                        <i class="bi bi-building"></i>

                        <h5>
                            Infrastructure Section
                        </h5>

                        <p>
                            Infrastructure development,
                            roads and public works.
                        </p>

                    </div>

                </div>


                <div class="col-md-6 col-lg-4">

                    <div class="department-card">

                        <i class="bi bi-heart-pulse-fill"></i>

                        <h5>
                            Social Development
                        </h5>

                        <p>
                            Social development and
                            community-focused programs.
                        </p>

                    </div>

                </div>


                <div class="col-md-6 col-lg-4">

                    <div class="department-card">

                        <i class="bi bi-heart-fill"></i>

                        <h5>
                            Health Section
                        </h5>

                        <p>
                            Health services and
                            community health programs.
                        </p>

                    </div>

                </div>


                <div class="col-md-6 col-lg-4">

                    <div class="department-card">

                        <i class="bi bi-mortarboard-fill"></i>

                        <h5>
                            Education Section
                        </h5>

                        <p>
                            Education services and
                            educational development.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>

<%- include("../layouts/footer") %>