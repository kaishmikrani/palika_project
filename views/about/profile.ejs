
<%- include("../layouts/header") %>

<%- include("../layouts/navbar") %>

<!-- Page Header -->
<section class="page-header">

    <div class="container">

        <h1>Municipality Profile</h1>

        <nav aria-label="breadcrumb">

            <ol class="breadcrumb mb-0">

                <li class="breadcrumb-item">
                    <a href="/">Home</a>
                </li>

                <li class="breadcrumb-item">
                    <a href="/about">About Us</a>
                </li>

                <li class="breadcrumb-item active">
                    Profile
                </li>

            </ol>

        </nav>

    </div>

</section>


<!-- Profile -->
<section class="py-5">

    <div class="container">

        <div class="row g-5 align-items-center">

            <!-- Image -->
            <div class="col-lg-6">

                <div class="profile-image">

                    <img
                        src="/images/palika.jpg"
                        alt="Bishnu Rural Municipality"
                        class="img-fluid"
                    >

                </div>

            </div>


            <!-- Introduction -->
            <div class="col-lg-6">

                <span class="section-subtitle">
                    About Municipality
                </span>

                <h2 class="section-title">
                    Bishnu Rural Municipality
                </h2>

                <p>
                    Bishnu Rural Municipality is a local government
                    institution committed to providing effective,
                    transparent and citizen-friendly public services.
                </p>

                <p>
                    The municipality works towards sustainable
                    development, infrastructure improvement,
                    social development and better public service
                    delivery.
                </p>

                <p>
                    This website provides citizens with information
                    about municipal services, notices, news,
                    publications and other important information.
                </p>

            </div>

        </div>

    </div>

</section>



<!-- Basic Information -->
<section class="py-5 bg-light">

    <div class="container">

        <div class="text-center mb-5">

            <span class="section-subtitle">
                Municipality Information
            </span>

            <h2 class="section-title">
                Basic Information
            </h2>

        </div>


        <div class="row g-4">

            <div class="col-md-6 col-lg-4">

                <div class="profile-info-card">

                    <i class="bi bi-geo-alt-fill"></i>

                    <div>

                        <h5>Province</h5>

                        <p class="mb-0">
                            Madesh Province
                        </p>

                    </div>

                </div>

            </div>


            <div class="col-md-6 col-lg-4">

                <div class="profile-info-card">

                    <i class="bi bi-map-fill"></i>

                    <div>

                        <h5>District</h5>

                        <p class="mb-0">
                            Sarlahi
                        </p>

                    </div>

                </div>

            </div>


            <div class="col-md-6 col-lg-4">

                <div class="profile-info-card">

                    <i class="bi bi-building-fill"></i>

                    <div>

                        <h5>Local Level</h5>

                        <p class="mb-0">
                            Rural Municipality
                        </p>

                    </div>

                </div>

            </div>


            <div class="col-md-6 col-lg-4">

                <div class="profile-info-card">

                    <i class="bi bi-people-fill"></i>

                    <div>

                        <h5>Population</h5>

                        <p class="mb-0">
                            2950
                        </p>

                    </div>

                </div>

            </div>


            <div class="col-md-6 col-lg-4">

                <div class="profile-info-card">

                    <i class="bi bi-signpost-fill"></i>

                    <div>

                        <h5>Wards</h5>

                        <p class="mb-0">
                            8
                        </p>

                    </div>

                </div>

            </div>


            <div class="col-md-6 col-lg-4">

                <div class="profile-info-card">

                    <i class="bi bi-calendar3"></i>

                    <div>

                        <h5>Established</h5>

                        <p class="mb-0">
                            24th May 2017
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>



<!-- Vision Mission -->
<section class="py-5">

    <div class="container">

        <div class="row g-4">

            <!-- Vision -->
            <div class="col-lg-6">

                <div class="vision-mission-card">

                    <div class="vision-icon">

                        <i class="bi bi-eye-fill"></i>

                    </div>

                    <h3>Our Vision</h3>

                    <p>
                        To build a prosperous, inclusive and
                        sustainable local community through
                        effective governance and development.
                    </p>

                </div>

            </div>


            <!-- Mission -->
            <div class="col-lg-6">

                <div class="vision-mission-card">

                    <div class="mission-icon">

                        <i class="bi bi-bullseye"></i>

                    </div>

                    <h3>Our Mission</h3>

                    <p>
                        To provide accessible and quality public
                        services while promoting transparency,
                        accountability and sustainable development.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>
