
<%- include("../layouts/header") %>

<%- include("../layouts/navbar") %>


<!-- Page Header -->
<section class="page-header">

    <div class="container">

        <h1 class="fw-bold">
            Ward No. 1
        </h1>

        <nav aria-label="breadcrumb">

            <ol class="breadcrumb mb-0">

                <li class="breadcrumb-item">
                    <a href="/">Home</a>
                </li>

                <li class="breadcrumb-item">
                    <a href="/wards">Wards</a>
                </li>

                <li class="breadcrumb-item active">
                    Ward Details
                </li>

            </ol>

        </nav>

    </div>

</section>


<section class="py-5">

    <div class="container">

        <div class="row g-4">

            <!-- Main -->
            <div class="col-lg-8">

                <!-- Ward Introduction -->
                <div class="ward-detail-card mb-4">

                    <div class="d-flex align-items-center gap-3 mb-4">

                        <div class="ward-detail-number">
                            01
                        </div>

                        <div>

                            <span class="badge bg-primary">
                                Ward No. 1
                            </span>

                            <h2 class="fw-bold mb-0 mt-1">
                                Ward Office
                            </h2>

                        </div>

                    </div>


                    <p>
                        This page provides information about the
                        ward office, local representatives, citizen
                        services and important contact information.
                    </p>

                    <p>
                        Citizens can visit the ward office to access
                        local government services and submit required
                        applications and documents.
                    </p>

                </div>


                <!-- Representative -->
                <div class="ward-detail-card mb-4">

                    <h4 class="fw-bold mb-4">
                        Ward Representative
                    </h4>

                    <div class="representative-box">

                        <div class="representative-photo">

                            <i class="bi bi-person"></i>

                        </div>

                        <div>

                            <h5 class="fw-bold mb-1">
                                Ward Chairperson
                            </h5>

                            <p class="text-muted mb-2">
                                Name will be displayed here
                            </p>

                            <div class="small">

                                <i class="bi bi-telephone me-2"></i>
                                Contact number

                            </div>

                        </div>

                    </div>

                </div>


                <!-- Ward Services -->
                <div class="ward-detail-card">

                    <h4 class="fw-bold mb-4">
                        Services Available
                    </h4>

                    <div class="row g-3">

                        <div class="col-md-6">

                            <div class="ward-service">

                                <i class="bi bi-person-vcard"></i>

                                <div>
                                    <h6>Registration Services</h6>
                                    <small>
                                        Birth, marriage and other
                                        registration services.
                                    </small>
                                </div>

                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="ward-service">

                                <i class="bi bi-file-earmark-check"></i>

                                <div>
                                    <h6>Recommendations</h6>
                                    <small>
                                        Various recommendation services.
                                    </small>
                                </div>

                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="ward-service">

                                <i class="bi bi-file-text"></i>

                                <div>
                                    <h6>Certificates</h6>
                                    <small>
                                        Local certificates and verification.
                                    </small>
                                </div>

                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="ward-service">

                                <i class="bi bi-people"></i>

                                <div>
                                    <h6>Citizen Support</h6>
                                    <small>
                                        General citizen assistance.
                                    </small>
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- Sidebar -->
            <div class="col-lg-4">

                <!-- Contact -->
                <div class="ward-sidebar-card mb-4">

                    <h4 class="fw-bold mb-4">
                        Ward Information
                    </h4>


                    <div class="ward-contact-item">

                        <i class="bi bi-geo-alt"></i>

                        <div>
                            <small>Office Location</small>
                            <strong>
                                Ward Office Location
                            </strong>
                        </div>

                    </div>


                    <div class="ward-contact-item">

                        <i class="bi bi-telephone"></i>

                        <div>
                            <small>Phone</small>
                            <strong>
                                Contact Number
                            </strong>
                        </div>

                    </div>


                    <div class="ward-contact-item">

                        <i class="bi bi-envelope"></i>

                        <div>
                            <small>Email</small>
                            <strong>
                                ward@example.com
                            </strong>
                        </div>

                    </div>


                    <div class="ward-contact-item">

                        <i class="bi bi-clock"></i>

                        <div>
                            <small>Office Hours</small>
                            <strong>
                                Office Working Hours
                            </strong>
                        </div>

                    </div>

                </div>


                <!-- Map Placeholder -->
                <div class="ward-map">

                    <div class="text-center">

                        <i class="bi bi-geo-alt-fill"></i>

                        <h5 class="fw-bold mt-2">
                            Ward Office Location
                        </h5>

                        <p class="small mb-0">
                            Map will be integrated later.
                        </p>

                    </div>

                </div>


                <a href="/wards"
                   class="btn btn-outline-primary w-100 mt-4">

                    <i class="bi bi-arrow-left me-1"></i>
                    Back to Wards

                </a>

            </div>

        </div>

    </div>

</section>

<%- include("../layouts/footer") %>