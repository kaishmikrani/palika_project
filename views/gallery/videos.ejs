<%- include("../layouts/header") %>

<%- include("../layouts/navbar") %>


<!-- Page Header -->
<section class="page-header">

    <div class="container">

        <h1 class="fw-bold">
            Video Gallery
        </h1>

        <nav aria-label="breadcrumb">

            <ol class="breadcrumb mb-0">

                <li class="breadcrumb-item">
                    <a href="/">Home</a>
                </li>

                <li class="breadcrumb-item">
                    <a href="/gallery">Gallery</a>
                </li>

                <li class="breadcrumb-item active">
                    Videos
                </li>

            </ol>

        </nav>

    </div>

</section>


<section class="py-5">

    <div class="container">

        <div class="text-center mb-5">

            <span class="badge bg-primary mb-2">
                Media Center
            </span>

            <h2 class="fw-bold">
                Video Gallery
            </h2>

            <p class="text-muted">
                Watch videos of municipality programs,
                activities and events.
            </p>

        </div>


        <!-- Gallery Navigation -->
        <div class="gallery-tabs text-center mb-5">

            <a href="/gallery"
               class="btn btn-outline-primary">

                <i class="bi bi-images me-1"></i>
                Photos

            </a>

            <a href="/gallery/videos"
               class="btn btn-primary">

                <i class="bi bi-play-btn me-1"></i>
                Videos

            </a>

        </div>


        <div class="row g-4">


            <!-- Video 1 -->
            <div class="col-lg-4 col-md-6">

                <div class="video-card">

                    <div class="video-thumbnail">

                        <img
                            src="/images/events/events.jpg"
                            alt="Municipality Program"
                        >

                        <div class="video-play">

                            <i class="bi bi-play-fill"></i>

                        </div>

                    </div>

                    <div class="p-3">

                        <span class="badge bg-primary">
                            Program
                        </span>

                        <h5 class="fw-bold mt-2">
                            Municipality Program
                        </h5>

                        <small class="text-muted">

                            <i class="bi bi-calendar3"></i>
                            2083

                        </small>

                    </div>

                </div>

            </div>


            <!-- Video 2 -->
            <div class="col-lg-4 col-md-6">

                <div class="video-card">

                    <div class="video-thumbnail">

                        <img
                            src="/images/events/events_10.jpg"
                            alt="Development Activities"
                        >

                        <div class="video-play">

                            <i class="bi bi-play-fill"></i>

                        </div>

                    </div>

                    <div class="p-3">

                        <span class="badge bg-success">
                            Development
                        </span>

                        <h5 class="fw-bold mt-2">
                            Development Activities
                        </h5>

                        <small class="text-muted">

                            <i class="bi bi-calendar3"></i>
                            2083

                        </small>

                    </div>

                </div>

            </div>


            <!-- Video 3 -->
            <div class="col-lg-4 col-md-6">

                <div class="video-card">

                    <div class="video-thumbnail">

                        <img
                            src="/images/events/events_3.jpg"
                            alt="Community Event"
                        >

                        <div class="video-play">

                            <i class="bi bi-play-fill"></i>

                        </div>

                    </div>

                    <div class="p-3">

                        <span class="badge bg-warning text-dark">
                            Events
                        </span>

                        <h5 class="fw-bold mt-2">
                            Community Event
                        </h5>

                        <small class="text-muted">

                            <i class="bi bi-calendar3"></i>
                            2082

                        </small>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>

<%- include("../layouts/footer") %>