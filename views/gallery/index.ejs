
<%- include("../layouts/header") %>

<%- include("../layouts/navbar") %>


<!-- Page Header -->
<section class="page-header">
    <div class="container">

        <div class="row align-items-center">

            <div class="col-lg-8">

                <h1 class="fw-bold">
                    Photo Gallery
                </h1>

                <p class="mb-0">
                    Explore photos of programs, activities,
                    events and development works.
                </p>

            </div>

            <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">

                <nav aria-label="breadcrumb">

                    <ol class="breadcrumb justify-content-lg-end mb-0">

                        <li class="breadcrumb-item">
                            <a href="/">Home</a>
                        </li>

                        <li class="breadcrumb-item active">
                            Gallery
                        </li>

                    </ol>

                </nav>

            </div>

        </div>

    </div>
</section>


<!-- Gallery -->
<section class="py-5">

    <div class="container">

        <!-- Heading -->
        <div class="text-center mb-4">

            <span class="badge bg-primary mb-2">
                Media Center
            </span>

            <h2 class="fw-bold">
                Photo Gallery
            </h2>

            <p class="text-muted">
                Photos from municipality activities and events.
            </p>

        </div>


        <!-- Gallery Navigation -->
        <div class="gallery-tabs text-center mb-5">

            <a href="/gallery"
               class="btn btn-primary">
                <i class="bi bi-images me-1"></i>
                Photos
            </a>

            <a href="/gallery/videos"
               class="btn btn-outline-primary">
                <i class="bi bi-play-btn me-1"></i>
                Videos
            </a>

        </div>


        <!-- Category Filter -->
        <div class="text-center mb-4">

            <button class="btn btn-sm btn-primary">
                All
            </button>

            <button class="btn btn-sm btn-outline-secondary">
                Programs
            </button>

            <button class="btn btn-sm btn-outline-secondary">
                Development
            </button>

            <button class="btn btn-sm btn-outline-secondary">
                Events
            </button>

            <button class="btn btn-sm btn-outline-secondary">
                Municipality
            </button>

        </div>


        <!-- Gallery Grid -->
        <div class="row g-4">


            <!-- Photo 1 -->
            <div class="col-lg-4 col-md-6">

                <div class="gallery-card">

                    <div class="gallery-image">

                        <img
                            src="/images/gallery-1.jpg"
                            alt="Municipality Program"
                        >

                        <button
                            class="gallery-view-btn"
                            data-bs-toggle="modal"
                            data-bs-target="#galleryModal"
                            data-image="/images/gallery-1.jpg"
                            data-title="Municipality Program">

                            <i class="bi bi-zoom-in"></i>

                        </button>

                    </div>

                    <div class="gallery-content">

                        <span class="badge bg-primary">
                            Programs
                        </span>

                        <h5 class="fw-bold mt-2">
                            Municipality Program
                        </h5>

                        <small class="text-muted">
                            <i class="bi bi-calendar3"></i>
                            2083
                        </small>

                    </div>

                </div>

            </div>


            <!-- Photo 2 -->
