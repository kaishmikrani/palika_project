<%- include("./layouts/header") %>

<%- include("./layouts/navbar") %>


<!-- =========================
     HERO IMAGE SLIDER
========================= -->

<section class="hero-slider">

    <div
        id="municipalityCarousel"
        class="carousel slide carousel-fade"
        data-bs-ride="carousel"
        data-bs-interval="5000"
    >

        <!-- Indicators -->

        <div class="carousel-indicators">

            <button
                type="button"
                data-bs-target="#municipalityCarousel"
                data-bs-slide-to="0"
                class="active"
            ></button>

            <button
                type="button"
                data-bs-target="#municipalityCarousel"
                data-bs-slide-to="1"
            ></button>

            <button
                type="button"
                data-bs-target="#municipalityCarousel"
                data-bs-slide-to="2"
            ></button>

            <button
                type="button"
                data-bs-target="#municipalityCarousel"
                data-bs-slide-to="3"
            ></button>

            <button
                type="button"
                data-bs-target="#municipalityCarousel"
                data-bs-slide-to="4"
            ></button>

        </div>


        <!-- Slides -->

        <div class="carousel-inner">


            <!-- Slide 1 -->

            <div class="carousel-item active">

                <img
                    src="/images/slides/slide_1.jpg"
                    class="d-block w-100 "
                    alt="Bishnu Rural Municipality"
                >

                <div class="carousel-caption">

                    <h2>
                        Bishnu Rural Municipality
                    </h2>

                    <p>
                        Welcome to the official website
                        of Bishnu Rural Municipality.
                    </p>

                </div>

            </div>


            <!-- Slide 2 -->

            <div class="carousel-item">

                <img
                    src="/images/slides/slide_2.jpg"
                    class="d-block w-100"
                    alt="Bishnu Rural Municipality"
                >

                <div class="carousel-caption">

                    <h2>
                        Our Municipality
                    </h2>

                    <p>
                        Working together for sustainable
                        rural development.
                    </p>

                </div>

            </div>


            <!-- Slide 3 -->

            <div class="carousel-item">

                <img
                    src="/images/slides/slide_3.jpg"
                    class="d-block w-100"
                    alt="Local Development"
                >

                <div class="carousel-caption">

                    <h2>
                        Development & Infrastructure
                    </h2>

                    <p>
                        Building better infrastructure
                        for our communities.
                    </p>

                </div>

            </div>


            <!-- Slide 4 -->

            <div class="carousel-item">

                <img
                    src="/images/slides/slide_4.jpg"
                    class="d-block w-100"
                    alt="Community"
                >

                <div class="carousel-caption">

                    <h2>
                        Community Development
                    </h2>

                    <p>
                        Together for a prosperous
                        and inclusive municipality.
                    </p>

                </div>

            </div>


            <!-- Slide 5 -->

            <div class="carousel-item">

                <img
                    src="/images/slides/slide_5.jpg"
                    class="d-block w-100"
                    alt="Bishnu Municipality"
                >

                <div class="carousel-caption">

                    <h2>
                        सेवा, सुशासन र विकास
                    </h2>

                    <p>
                        समृद्ध बिष्णु गाउँपालिकाको हाम्रो अभियान
                    </p>

                </div>

            </div>

        </div>


        <!-- Previous -->

        <button
            class="carousel-control-prev"
            type="button"
            data-bs-target="#municipalityCarousel"
            data-bs-slide="prev"
        >

            <span class="carousel-control-prev-icon"></span>

            <span class="visually-hidden">
                Previous
            </span>

        </button>


        <!-- Next -->

        <button
            class="carousel-control-next"
            type="button"
            data-bs-target="#municipalityCarousel"
            data-bs-slide="next"
        >

            <span class="carousel-control-next-icon"></span>

            <span class="visually-hidden">
                Next
            </span>

        </button>

    </div>

</section>



<!-- =========================
     WELCOME SECTION
========================= -->

<section class="welcome-section py-5">

    <div class="container">

        <div class="row align-items-center">

            <div class="col-lg-7">

                <span class="section-label">
                    Welcome
                </span>

                <h2 class="mt-2">
                    Welcome to Bishnu Rural Municipality
                </h2>

                <p class="text-muted">
                    Welcome to the official website of
                    Bishnu Rural Municipality. This website
                    provides information about municipal
                    services, notices, news, development
                    activities and important documents.
                </p>

                <p class="text-muted">
                    Our goal is to provide transparent,
                    accessible and citizen-friendly public
                    services through effective local
                    governance.
                </p>

                <a href="/about" class="btn btn-primary">
                    Read More
                    <i class="bi bi-arrow-right"></i>
                </a>

            </div>


            <div class="col-lg-5 mt-4 mt-lg-0">

                <div class="welcome-card">

                    <div class="icon-box">
                        <i class="bi bi-building"></i>
                    </div>

                    <h4>
                        Office of the Rural Municipal Executive
                    </h4>

                    <p>
                        Bishnu Rural Municipality
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>



<!-- =========================
     QUICK SERVICES
========================= -->

<section class="services-section py-5">

    <div class="container">

        <div class="section-heading text-center">

            <span class="section-label">
