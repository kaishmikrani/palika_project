            <p class="text-muted">
                Access important municipal services quickly
                and easily.
            </p>

        </div>


        <div class="row g-4 mt-3">


            <div class="col-md-6 col-lg-3">

                <a href="/services" class="service-card">

                    <div class="service-icon">
                        <i class="bi bi-file-earmark-text"></i>
                    </div>

                    <h5>
                        Online Services
                    </h5>

                    <p>
                        Access municipal online services.
                    </p>

                </a>

            </div>


            <div class="col-md-6 col-lg-3">

                <a href="/downloads" class="service-card">

                    <div class="service-icon">
                        <i class="bi bi-download"></i>
                    </div>

                    <h5>
                        Downloads
                    </h5>

                    <p>
                        Download forms and important documents.
                    </p>

                </a>

            </div>


            <div class="col-md-6 col-lg-3">

                <a href="/notices" class="service-card">

                    <div class="service-icon">
                        <i class="bi bi-megaphone"></i>
                    </div>

                    <h5>
                        Notices
                    </h5>

                    <p>
                        View the latest official notices.
                    </p>

                </a>

            </div>


            <div class="col-md-6 col-lg-3">

                <a href="/wards" class="service-card">

                    <div class="service-icon">
                        <i class="bi bi-geo-alt"></i>
                    </div>

                    <h5>
                        Ward Information
                    </h5>

                    <p>
                        Explore information about our wards.
                    </p>

                </a>

            </div>

        </div>

    </div>

</section>



