<%- include("../layouts/header") %>

<%- include("../layouts/navbar") %>

<!-- Page Header -->
<section class="page-header">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <h1 class="fw-bold">Citizen Services</h1>
                <p class="mb-0">
                    Access various services provided by Bishnu Rural Municipality.
                </p>
            </div>

           
        </div>
         <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb justify-content-lg-start mb-0">
                        <li class="breadcrumb-item">
                            <a href="/">Home</a>
                        </li>
                        <li class="breadcrumb-item active">
                            Services
                        </li>
                    </ol>
                </nav>
            </div>
    </div>
</section>


<!-- Services Section -->
<section class="py-5">
    <div class="container">

        <!-- Search -->
        <div class="service-search mb-5">
            <div class="row g-3">

                <div class="col-md-8">
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="bi bi-search"></i>
                        </span>

                        <input
                            type="text"
                            class="form-control"
                            placeholder="Search for a service..."
                        >
                    </div>
                </div>

                <div class="col-md-4">
                    <select class="form-select">
                        <option selected>All Categories</option>
                        <option>Registration</option>
                        <option>Recommendation</option>
                        <option>Social Security</option>
                        <option>Business</option>
                        <option>Other Services</option>
                    </select>
                </div>

            </div>
        </div>


        <div class="row g-4">

            <!-- Service Card -->
            <div class="col-lg-4 col-md-6">
                <div class="service-card h-100">

                    <div class="service-icon">
                        <i class="bi bi-person-vcard"></i>
                    </div>

                    <span class="badge bg-primary mb-3">
                        Registration
                    </span>

                    <h4>Birth Registration</h4>

                    <p>
                        Apply for birth registration and obtain
                        the required registration certificate.
                    </p>

                    <div class="service-meta">
                        <div>
                            <i class="bi bi-clock"></i>
                            Processing: 1–3 Days
                        </div>

                        <div>
                            <i class="bi bi-file-earmark-text"></i>
                            Required Documents
                        </div>
                    </div>

                    <a href="/services/birth-registration"
                       class="btn btn-outline-primary mt-3">
                        View Details
                        <i class="bi bi-arrow-right"></i>
                    </a>

                </div>
            </div>


            <!-- Service Card -->
            <div class="col-lg-4 col-md-6">
                <div class="service-card h-100">

                    <div class="service-icon">
                        <i class="bi bi-file-earmark-check"></i>
                    </div>

                    <span class="badge bg-success mb-3">
                        Recommendation
                    </span>

                    <h4>Relationship Certificate</h4>

                    <p>
                        Apply for a relationship verification
                        recommendation from the municipality.
                    </p>

                    <div class="service-meta">
                        <div>
                            <i class="bi bi-clock"></i>
                            Processing: 1–3 Days
                        </div>

                        <div>
                            <i class="bi bi-file-earmark-text"></i>
                            Required Documents
                        </div>
                    </div>

                    <a href="/services/relationship-certificate"
                       class="btn btn-outline-primary mt-3">
                        View Details
                        <i class="bi bi-arrow-right"></i>
                    </a>

                </div>
            </div>


            <!-- Service Card -->
            <div class="col-lg-4 col-md-6">
                <div class="service-card h-100">

                    <div class="service-icon">
                        <i class="bi bi-house-check"></i>
                    </div>

                    <span class="badge bg-warning text-dark mb-3">
                        Recommendation
                    </span>

                    <h4>House / Residence Recommendation</h4>

                    <p>
                        Request recommendation related to
                        residence and house verification.
                    </p>

                    <div class="service-meta">
                        <div>
                            <i class="bi bi-clock"></i>
                            Processing: 1–3 Days
                        </div>

                        <div>
                            <i class="bi bi-file-earmark-text"></i>
                            Required Documents
                        </div>
                    </div>

                    <a href="/services/residence-recommendation"
                       class="btn btn-outline-primary mt-3">
                        View Details
                        <i class="bi bi-arrow-right"></i>
                    </a>

                </div>
            </div>


            <!-- Service Card -->
            <div class="col-lg-4 col-md-6">
                <div class="service-card h-100">

                    <div class="service-icon">
                        <i class="bi bi-heart"></i>
                    </div>

                    <span class="badge bg-danger mb-3">
                        Registration
                    </span>

                    <h4>Marriage Registration</h4>

                    <p>
                        Information and application process for
                        marriage registration.
                    </p>

                    <div class="service-meta">
                        <div>
                            <i class="bi bi-clock"></i>
                            Processing: 1–3 Days
                        </div>

                        <div>
                            <i class="bi bi-file-earmark-text"></i>
                            Required Documents
                        </div>
                    </div>

                    <a href="/services/marriage-registration"
                       class="btn btn-outline-primary mt-3">
                        View Details
                        <i class="bi bi-arrow-right"></i>
                    </a>

                </div>
            </div>


            <!-- Service Card -->
            <div class="col-lg-4 col-md-6">
                <div class="service-card h-100">

                    <div class="service-icon">
                        <i class="bi bi-shop"></i>
                    </div>

                    <span class="badge bg-info text-dark mb-3">
                        Business
                    </span>

                    <h4>Business Registration</h4>

                    <p>
                        Information about registering a local
                        business and obtaining required approval.
                    </p>

                    <div class="service-meta">
                        <div>
                            <i class="bi bi-clock"></i>
                            Processing: 3–7 Days
                        </div>

                        <div>
                            <i class="bi bi-file-earmark-text"></i>
                            Required Documents
                        </div>
                    </div>

                    <a href="/services/business-registration"
                       class="btn btn-outline-primary mt-3">
                        View Details
                        <i class="bi bi-arrow-right"></i>
                    </a>

                </div>
            </div>


            <!-- Service Card -->
            <div class="col-lg-4 col-md-6">
                <div class="service-card h-100">

                    <div class="service-icon">
                        <i class="bi bi-file-text"></i>
                    </div>

                    <span class="badge bg-secondary mb-3">
                        Other Services
                    </span>

                    <h4>Various Recommendations</h4>

                    <p>
                        Access different recommendation and
                        verification services provided by the municipality.
                    </p>

                    <div class="service-meta">
                        <div>
                            <i class="bi bi-clock"></i>
                            Processing: Depends on Service
                        </div>

                        <div>
                            <i class="bi bi-file-earmark-text"></i>
                            Required Documents
                        </div>
                    </div>

                    <a href="/services/recommendations"
                       class="btn btn-outline-primary mt-3">
                        View Details
                        <i class="bi bi-arrow-right"></i>
                    </a>

                </div>
            </div>

        </div>

    </div>
</section>

<%- include("../layouts/footer") %>