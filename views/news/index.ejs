                        >

                    </div>

                    <div class="news-list-content">

                        <span class="badge bg-success mb-2">
                            Development
                        </span>

                        <h4 class="fw-bold">
                            Local Development Activities
                        </h4>

                        <div class="news-date">

                            <i class="bi bi-calendar3"></i>
                            Published: 2083

                        </div>

                        <p>
                            Information about development projects
                            and activities being carried out locally.
                        </p>

                        <a href="/news/3"
