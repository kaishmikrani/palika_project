                        >

                    </div>

                    <div class="news-list-content">

                        <span class="badge bg-warning text-dark mb-2">
                            Events
                        </span>

                        <h4 class="fw-bold">
                            Community Program and Events
                        </h4>

                        <div class="news-date">

                            <i class="bi bi-calendar3"></i>
                            Published: 2082

                        </div>

                        <p>
                            Details about community programs,
                            meetings and municipality events.
                        </p>

                        <a href="/news/4"
