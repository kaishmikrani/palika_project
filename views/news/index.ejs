
<%- include("../layouts/header") %>

<%- include("../layouts/navbar") %>

<!-- Page Header -->
<section class="page-header">
    <div class="container">

        <div class="row align-items-center">

            <div class="col-lg-8">

                <h1 class="fw-bold">
                    News & Events
                </h1>

                <p class="mb-0">
                    Latest news, announcements, activities and
                    events of Bishnu Rural Municipality.
                </p>

            </div>

           

        </div>
         <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">

                <nav aria-label="breadcrumb">

                    <ol class="breadcrumb justify-content-lg-start mb-0">

                        <li class="breadcrumb-item">
                            <a href="/">Home</a>
                        </li>

                        <li class="breadcrumb-item active">
                            News & Events
                        </li>

                    </ol>

                </nav>

            </div>

    </div>
</section>


<!-- Featured News -->
<section class="py-5">

    <div class="container">

        <div class="section-title mb-4">

            <span class="badge bg-primary mb-2">
                Featured
            </span>

            <h2 class="fw-bold">
                Latest News
            </h2>

        </div>


        <div class="featured-news">

            <div class="row g-0 align-items-stretch">

                <div class="col-lg-6">

                    <div class="featured-news-image">

                        <img
                            src="/images/events/events_10.jpg"
                            alt="Featured News"
                        >

                        <span class="badge bg-danger">
                            Featured
                        </span>

                    </div>

                </div>


                <div class="col-lg-6">

                    <div class="featured-news-content">

                        <span class="badge bg-primary mb-3">
                            Municipality News
                        </span>

                        <h2 class="fw-bold">
                            Municipality Development and
                            Public Service Activities
                        </h2>

                        <div class="news-date mb-3">

                            <i class="bi bi-calendar3"></i>

                            Published: 2083

                        </div>

                        <p>
                            Information about recent development
                            activities, public services and
                            important municipal initiatives.
                        </p>

                        <a href="/news/1"
                           class="btn btn-primary">

                            Read More

                            <i class="bi bi-arrow-right ms-1"></i>

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- News Section -->
<section class="pb-5">

    <div class="container">

        <div class="row g-4">

            <!-- Main News -->
            <div class="col-lg-8">

                <div class="d-flex justify-content-between
                            align-items-center mb-4">

                    <div>

                        <h3 class="fw-bold mb-1">
                            Latest Updates
                        </h3>

                        <p class="text-muted mb-0">
                            Recent municipality news and activities.
                        </p>

                    </div>

                </div>


                <!-- Filter -->
                <div class="news-filter mb-4">

                    <div class="row g-3">

                        <div class="col-md-7">

                            <div class="input-group">

                                <span class="input-group-text">
                                    <i class="bi bi-search"></i>
                                </span>

                                <input
                                    type="text"
                                    class="form-control"
                                    placeholder="Search news..."
                                >

                            </div>

                        </div>

                        <div class="col-md-5">

                            <select class="form-select">

                                <option selected>
                                    All Categories
                                </option>

                                <option>
                                    Municipality News
                                </option>

                                <option>
                                    Development
                                </option>

                                <option>
                                    Events
                                </option>

                                <option>
                                    Announcements
                                </option>

                            </select>

                        </div>

                    </div>

                </div>


                <!-- News Item -->
                <div class="news-list-card mb-4">

                    <div class="news-list-image">

                        <img
                            src="/images/events/events_2.jpg"
                            alt="Municipality News"
                        >

                    </div>

                    <div class="news-list-content">

                        <span class="badge bg-primary mb-2">
                            Municipality News
                        </span>

                        <h4 class="fw-bold">
                            Public Service Improvement Activities
                        </h4>

                        <div class="news-date">

                            <i class="bi bi-calendar3"></i>
                            Published: 2083

                        </div>

                        <p>
                            Updates regarding public service
                            improvement and municipal activities.
                        </p>

                        <a href="/news/2"
                           class="btn btn-sm btn-outline-primary">

                            Read More
                            <i class="bi bi-arrow-right"></i>

                        </a>

                    </div>

                </div>


                <!-- News Item -->
                <div class="news-list-card mb-4">

                    <div class="news-list-image">

                        <img
                            src="/images/events/events_3.jpg"
