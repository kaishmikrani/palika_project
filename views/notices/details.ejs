<%- include("../layouts/header") %>

<%- include("../layouts/navbar") %>


<!-- =========================
     PAGE HEADER
========================= -->

<section class="page-header">

    <div class="container">

        <h1>
            Notice Details
        </h1>

        <nav aria-label="breadcrumb">

            <ol class="breadcrumb mb-0">

                <li class="breadcrumb-item">
                    <a href="/">Home</a>
                </li>

                <li class="breadcrumb-item">
                    <a href="/notices">Notices</a>
                </li>

                <li class="breadcrumb-item active">
                    Details
                </li>

            </ol>

        </nav>

    </div>

</section>



<!-- =========================
     NOTICE DETAILS
========================= -->

<section class="py-5">

    <div class="container">

        <div class="row g-4">


            <!-- Main Content -->

            <div class="col-lg-8">

                <article class="notice-detail-card">


                    <div class="notice-detail-top">

                        <span class="badge text-bg-primary">
                            Public Notice
                        </span>

                        <span class="badge text-bg-danger">
                            Important
                        </span>

                    </div>


                    <h1 class="notice-detail-title">

                        Important Notice Regarding
                        Municipal Services

                    </h1>


                    <div class="notice-detail-meta">

                        <span>
                            <i class="bi bi-calendar3"></i>
                            September 10, 2026
                        </span>

                        <span>
                            <i class="bi bi-building"></i>
                            Bishnu Rural Municipality
                        </span>

                    </div>


                    <hr>


                    <div class="notice-detail-content">

                        <p>
                            Bishnu Rural Municipality would like
                            to inform all concerned citizens about
                            the following important information.
                        </p>

                        <p>
                            Citizens are requested to carefully
                            review the information provided in
                            this notice and take necessary action
                            within the specified period.
                        </p>


                        <h4>
                            Important Information
                        </h4>

                        <p>
                            The municipality is committed to
                            providing transparent, efficient and
                            citizen-friendly services.
                        </p>


                        <ul>

                            <li>
                                Citizens should submit the
                                required documents.
                            </li>

                            <li>
                                Applications should be submitted
                                within the specified deadline.
                            </li>

                            <li>
                                For additional information,
                                contact the municipality office.
                            </li>

                        </ul>


                        <p>
                            For further details, please contact
                            the concerned department of Bishnu
                            Rural Municipality.
                        </p>

                    </div>


                    <!-- Attachment -->

                    <div class="notice-attachment mt-4">

                        <div class="attachment-icon">

                            <i class="bi bi-file-earmark-pdf"></i>

                        </div>

                        <div class="flex-grow-1">

                            <h6>
                                Official Notice Document
                            </h6>

                            <small class="text-muted">
                                PDF Document
                            </small>

                        </div>

                        <a
                            href="#"
                            class="btn btn-primary"
                        >
                            <i class="bi bi-download"></i>
                            Download
                        </a>

                    </div>


                    <!-- Share -->

                    <div class="notice-share mt-4">

                        <span>
                            Share this notice:
                        </span>

                        <button class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-facebook"></i>
                        </button>

                        <button class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-twitter-x"></i>
                        </button>

                        <button class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-link-45deg"></i>
                        </button>

                    </div>

                </article>

            </div>



            <!-- Sidebar -->

            <div class="col-lg-4">


                <div class="detail-sidebar">

                    <h4>
                        Notice Information
                    </h4>


                    <div class="sidebar-info">

                        <span>
                            Category
                        </span>

                        <strong>
                            Public Notice
                        </strong>

                    </div>


                    <div class="sidebar-info">

                        <span>
                            Published Date
                        </span>

                        <strong>
                            September 10, 2026
                        </strong>

                    </div>


                    <div class="sidebar-info">

                        <span>
                            Published By
                        </span>

                        <strong>
                            Bishnu Rural Municipality
                        </strong>

                    </div>


                </div>



                <!-- Related -->

                <div class="related-notices mt-4">

                    <h4>
                        Related Notices
                    </h4>


                    <a href="/notices/2">

                        <i class="bi bi-file-text"></i>

                        <span>
                            Public Information Announcement
                        </span>

                    </a>


                    <a href="/notices/3">

                        <i class="bi bi-file-text"></i>

                        <span>
                            Notice Regarding Citizen Services
                        </span>

                    </a>


                    <a href="/notices/4">

                        <i class="bi bi-file-text"></i>

                        <span>
                            Municipal Development Program
                        </span>

                    </a>

                </div>

            </div>

        </div>

    </div>

</section>


